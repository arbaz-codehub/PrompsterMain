---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Contact Us — Prompster" description="Get in touch with Prompster for any queries or support.">
  <Header slot="header" />
  
  <main class="contact-page">
    <section class="contact-hero container">
      <div class="contact-hero__content">
        <img src="/Prompster_Logo.webp" alt="Prompster Logo" class="contact-logo" width="83" height="100" />
        <h1 class="contact-title">Contact <span class="text-gradient">Prompster</span></h1>
        <p class="contact-subtitle">
          We're always here to help. Reach out if you have any questions about our tools, libraries, or digital products.
        </p>
      </div>
      
      <!-- Decorative background elements -->
      <div class="glow glow-1"></div>
      <div class="glow glow-2"></div>
    </section>

    <section class="container contact-details">
      <div class="glass-card contact-card">
        <div class="contact-card__section">
          <div class="contact-icon-wrapper">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </div>
          <div class="contact-card__info">
            <h2 class="contact-card__title">Email Support</h2>
            <p class="contact-card__desc">We typically respond within 24 hours to all inquiries.</p>
            <a href="mailto:prompsterai@gmail.com" class="contact-card__link">prompsterai@gmail.com</a>
          </div>
        </div>

        <div class="contact-card__divider"></div>
        
        <div class="contact-card__section">
          <div class="contact-icon-wrapper">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="contact-card__info">
            <h2 class="contact-card__title">Business Address</h2>
            <p class="contact-card__desc">Prompster HQ operates globally, but is based out of India.</p>
            <address class="contact-card__address">
              Prompster HQ<br>
              (Operating Remotely)<br>
              India
            </address>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .contact-page {
    padding-top: calc(var(--header-height) + var(--space-12));
    padding-bottom: var(--space-20);
    position: relative;
    overflow: hidden;
  }

  .contact-hero {
    text-align: center;
    position: relative;
    padding-bottom: var(--space-12);
  }

  .contact-hero__content {
    position: relative;
    z-index: 2;
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-logo {
    width: 80px;
    height: auto;
    margin: 0 auto var(--space-6);
    filter: drop-shadow(0 8px 16px rgba(0,0,0,0.4));
    animation: float 6s ease-in-out infinite;
  }

  .contact-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
  }

  .text-gradient {
    background: linear-gradient(135deg, #fff 0%, var(--color-accent-primary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .contact-subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Decorative Glows */
  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.15;
    z-index: 1;
    pointer-events: none;
  }
  .glow-1 {
    top: -20%;
    left: 20%;
    width: 300px;
    height: 300px;
    background: var(--color-accent-primary);
  }
  .glow-2 {
    bottom: 0;
    right: 10%;
    width: 400px;
    height: 400px;
    background: var(--color-accent-emerald);
  }

  /* Contact Card */
  .contact-details {
    max-width: 700px;
    position: relative;
    z-index: 2;
  }

  .contact-card {
    padding: var(--space-10);
    border-radius: var(--radius-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    background: linear-gradient(145deg, rgba(30,30,30,0.6), rgba(10,10,10,0.8));
    border: 1px solid rgba(255,255,255,0.08);
    box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  }

  .contact-card__section {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
  }

  .contact-icon-wrapper {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-xl);
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent-primary);
    box-shadow: inset 0 2px 10px rgba(0,0,0,0.2);
  }

  .contact-card__info {
    flex: 1;
  }

  .contact-card__title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-2);
  }

  .contact-card__desc {
    color: var(--color-text-secondary);
    font-size: var(--text-base);
    line-height: 1.5;
    margin-bottom: var(--space-3);
  }

  .contact-card__link {
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-accent-primary);
    text-decoration: none;
    transition: color 0.2s ease;
    display: inline-block;
  }
  .contact-card__link:hover {
    color: var(--color-text-primary);
  }

  .contact-card__address {
    font-style: normal;
    color: var(--color-text-primary);
    font-size: var(--text-base);
    line-height: 1.6;
    font-weight: 500;
  }

  .contact-card__divider {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
    width: 100%;
  }

  @keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
    100% { transform: translateY(0px); }
  }

  @media (max-width: 640px) {
    .contact-card {
      padding: var(--space-6);
      gap: var(--space-6);
    }
    .contact-card__section {
      flex-direction: column;
      gap: var(--space-4);
      align-items: center;
      text-align: center;
    }
  }
</style>
