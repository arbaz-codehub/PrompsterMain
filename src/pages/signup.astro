---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Optional: check if we got redirected back with an error from the callback
const url = new URL(Astro.request.url);
const errorMsg = url.searchParams.get('error') === 'auth_failed' ? 'Authentication failed. Please try again.' : '';
---

<BaseLayout title="Sign Up" description="Create an account to personalize your AI prompt feed.">
  <Header slot="header" />

  <main style="display: flex; align-items: center; justify-content: center; min-height: 100vh; padding-top: var(--header-height); padding-bottom: 2rem; padding-left: 2rem; padding-right: 2rem;">
    <div style="max-width: 400px; width: 100%; background: var(--color-bg); padding: 2.5rem; border-radius: var(--radius-lg); border: 1px solid var(--color-border); box-shadow: 0 20px 40px rgba(0,0,0,0.5);">
      <h1 style="text-align: center; margin-bottom: 2rem; margin-top: 0;">Create Account</h1>
      
      {errorMsg && (
        <div class="auth-error" style="display: flex; align-items: flex-start; gap: 0.75rem; background: rgba(255,59,48,0.08); border: 1px solid rgba(255,59,48,0.2); color: #ff6b6b; padding: 1rem 1.25rem; border-radius: 10px; margin-bottom: 1.25rem; font-size: 0.9rem; line-height: 1.5; animation: slideDown 0.3s ease-out;">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink: 0; margin-top: 1px;">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12.01" y2="16"></line>
          </svg>
          <span>{errorMsg}</span>
        </div>
      )}

      <div style="display: flex; flex-direction: column; gap: 1.25rem;">
        <button id="google-signup-btn" class="btn btn--secondary" style="width: 100%; padding: 0.875rem; font-weight: 600; display: flex; align-items: center; justify-content: center; gap: 0.75rem; position: relative; background: var(--color-bg-secondary); border: 1px solid var(--color-border);">
          <svg width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          <span class="btn-text">Continue with Google</span>
          <span class="btn-spinner" style="display: none;">
            <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="animation: spin 0.8s linear infinite;">
              <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="31.4 31.4" stroke-linecap="round" />
            </svg>
          </span>
        </button>
      </div>

      <p style="text-align: center; margin-top: 2rem; margin-bottom: 0; color: var(--color-text-secondary);">
        Already have an account? <a href="/login" style="color: var(--color-accent); text-decoration: none; font-weight: 500;">Log in</a>
      </p>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: translateY(0); }
  }
  #google-signup-btn:disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
</style>

<script>
  import { createBrowserClient } from '@supabase/ssr';

  const btn = document.getElementById('google-signup-btn') as HTMLButtonElement;
  const btnText = btn?.querySelector('.btn-text') as HTMLElement;
  const btnSpinner = btn?.querySelector('.btn-spinner') as HTMLElement;

  if (btn) {
    btn.addEventListener('click', async () => {
      // Show loading state
      btn.disabled = true;
      btnText.textContent = 'Redirecting...';
      btnSpinner.style.display = 'inline-flex';

      const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
      const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

      if (!supabaseUrl || !supabaseAnonKey) {
        console.error("Supabase environment variables are missing.");
        return;
      }

      const supabase = createBrowserClient(supabaseUrl, supabaseAnonKey);

      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: {
          redirectTo: `${window.location.origin}/api/auth/callback`,
        },
      });

      if (error) {
        console.error('Error logging in with Google:', error.message);
        btn.disabled = false;
        btnText.textContent = 'Continue with Google';
        btnSpinner.style.display = 'none';
        alert("Failed to log in with Google.");
      }
    });
  }
</script>

