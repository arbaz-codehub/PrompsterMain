---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";

const siteUrl = import.meta.env.SITE_URL || "https://www.prompster.shop";

const user = Astro.locals.user;
---

<BaseLayout
  title="Prompt Library - Prompster"
  description="Save, organize, and manage your AI prompts in a personal library."
  canonicalUrl={`${siteUrl}/tools/prompt-library`}
>
  <Header slot="header" />

  <main class="prompt-library-page container">
    <header class="library-header">
      <div>
        <h1 class="library-title">Prompt Library</h1>
        <p class="library-subtitle">Your personal library of prompts — for using, reusing, and selling.</p>
      </div>
      <div class="header-stats">
        <span class="stat-pill" id="statPill">0 prompts saved</span>
      </div>
    </header>

    <div class="toolbar">
      <div class="search-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="search-icon"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="searchInput" placeholder="Search by title or tag..." aria-label="Search prompts" class="input-base">
      </div>
      <div class="tabs" id="filterTabs">
        <!-- Generated dynamically -->
      </div>
      <div class="toolbar-actions">
        <button class="btn btn--ghost btn--sm" id="importBtn" aria-label="Import backup">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
          <span>Import</span>
        </button>
        <input type="file" id="importFile" accept="application/json" hidden>
        <button class="btn btn--ghost btn--sm" id="exportBtn" aria-label="Export backup">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          <span>Export</span>
        </button>
        <button class="btn btn--primary btn--sm" id="newPromptBtn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          <span>Add Prompt</span>
        </button>
      </div>
    </div>

    <!-- Collections -->
    <section class="collections-section" id="collectionsSection" hidden>
      <div class="collections-header">
        <h2 class="section-title">Collections</h2>
        <button class="btn btn--ghost btn--sm" id="newCollectionBtn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2Z"></path><line x1="12" y1="11" x2="12" y2="17"></line><line x1="9" y1="14" x2="15" y2="14"></line></svg>
          <span>New Collection</span>
        </button>
      </div>
      <div class="collections-row" id="collectionsRow"></div>
    </section>

    <!-- Collection detail header -->
    <div class="collection-detail-header" id="collectionHeader" hidden>
      <div class="collection-detail-top-bar">
        <button class="btn btn--ghost btn--sm back-btn" id="backToAllBtn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          <span>Back to Library</span>
        </button>
        <div class="collection-detail-actions">
          <button class="btn btn--ghost btn--sm" id="renameCollectionBtn">Rename</button>
          <button class="btn btn--danger btn--sm" id="deleteCollectionBtn">Delete</button>
        </div>
      </div>
      <div class="collection-detail-info">
        <h2 class="section-title" id="collectionHeaderTitle"></h2>
        <span class="collection-count" id="collectionHeaderCount"></span>
      </div>
    </div>

    <div class="loading-state" id="loadingState">Loading your library...</div>
    <div class="lib-prompt-grid" id="promptGrid" hidden></div>
    
    <div class="empty-state glass-card" id="emptyState" hidden>
      <div id="emptyStateContent"></div>
    </div>
  </main>

  <Footer slot="footer" />

  <!-- Add/Edit Prompt Modal -->
  <div class="modal-overlay" id="promptModal" hidden>
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title" id="promptModalTitle">Add Prompt</h2>
        <button class="icon-btn close-modal" aria-label="Close">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="modal-body">
        <div class="field" id="fieldTitleWrap">
          <label for="fieldTitle">Title</label>
          <input type="text" id="fieldTitle" class="input-base" placeholder="e.g. Product description generator">
          <div class="field-error">Title is required.</div>
        </div>
        <div class="field" id="fieldContentWrap">
          <label for="fieldContent">Prompt Content</label>
          <textarea id="fieldContent" class="input-base textarea" placeholder="Paste or write the full prompt here..."></textarea>
          <div class="field-hint" id="charCount">0 characters</div>
          <div class="field-error">Content is required.</div>
        </div>
        <div class="field" id="fieldExampleWrap">
          <label for="fieldExample">Example Usage (optional)</label>
          <textarea id="fieldExample" class="input-base textarea" style="min-height: 120px;" placeholder="Provide a completed example..."></textarea>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="fieldCategory">Category</label>
            <input type="text" id="fieldCategory" class="input-base" list="categoryList" placeholder="e.g. Personal, Selling, Midjourney">
            <datalist id="categoryList"></datalist>
          </div>
          <div class="field">
            <label for="fieldPrice">Price / Note (optional)</label>
            <input type="text" id="fieldPrice" class="input-base" placeholder="e.g. $5 on Etsy">
          </div>
        </div>
        <div class="field">
          <label for="fieldTags">Tags (comma separated)</label>
          <input type="text" id="fieldTags" class="input-base" placeholder="marketing, midjourney, seo">
        </div>
        <div class="field" id="fieldCollectionWrap">
          <label for="fieldCollection">Collection</label>
          <select id="fieldCollection" class="input-base">
            <option value="" disabled selected>Select a collection</option>
          </select>
          <div class="field-error">Collection is required.</div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn--ghost close-modal">Cancel</button>
        <button class="btn btn--primary" id="savePromptBtn">Save Prompt</button>
      </div>
    </div>
  </div>

  <!-- Add/Edit Collection Modal -->
  <div class="modal-overlay" id="collectionModal" hidden>
    <div class="modal-content" style="max-width: 420px;">
      <div class="modal-header">
        <h2 class="modal-title" id="collectionModalTitle">New Collection</h2>
        <button class="icon-btn close-modal" aria-label="Close">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="modal-body">
        <div class="field" id="collectionNameWrap">
          <label for="collectionNameInput">Collection Name</label>
          <input type="text" id="collectionNameInput" class="input-base" placeholder="e.g. SEO Prompts">
          <div class="field-error">Name is required.</div>
        </div>
        <div class="field" id="collectionDescWrap">
          <label for="collectionDescInput">Subinfo / Description (optional)</label>
          <input type="text" id="collectionDescInput" class="input-base" placeholder="e.g. Prompts Full for Students">
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn btn--ghost close-modal">Cancel</button>
        <button class="btn btn--primary" id="saveCollectionBtn">Save Collection</button>
      </div>
    </div>
  </div>

  <!-- Confirm Modal -->
  <div class="modal-overlay" id="confirmModal" hidden>
    <div class="modal-content" style="max-width: 400px; padding-bottom: 1.5rem;">
      <div class="modal-header">
        <h2 class="modal-title" id="confirmTitle">Confirm Action</h2>
        <button class="icon-btn close-modal" aria-label="Close">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="modal-body" style="padding-top: var(--space-4);">
        <p id="confirmMessage" style="color: var(--color-text-secondary); line-height: 1.5;"></p>
      </div>
      <div class="modal-footer" style="border: none;">
        <button class="btn btn--ghost close-modal">Cancel</button>
        <button class="btn btn--danger" id="confirmActionBtn">Yes, do it</button>
      </div>
    </div>
  </div>

  <!-- View Prompt Modal -->
  <div class="modal-overlay" id="viewPromptModal" hidden>
    <div class="modal-content" style="max-width: 700px;">
      <div class="modal-header">
        <h2 class="modal-title" id="viewPromptTitle">Prompt</h2>
        <button class="icon-btn close-modal" aria-label="Close">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>
      <div class="modal-body" style="padding-top: 0; margin-top: var(--space-4);">
        <label style="font-weight: 500; margin-bottom: 8px; display: block; color: var(--color-text-secondary);">Prompt Template</label>
        <pre class="lib-code-content" id="viewPromptContent" style="white-space: pre-wrap; font-size: 0.9rem; background: var(--color-bg-elevated); padding: 1rem; border-radius: 8px; border: 1px solid var(--color-border-subtle); max-height: 40vh; overflow-y: auto; font-family: monospace; margin: 0; line-height: 1.5;"></pre>
        
        <div id="viewPromptExampleWrap" style="margin-top: 1.5rem; display: none;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <label style="font-weight: 500; color: var(--color-text-secondary);">Example Usage</label>
            <button class="btn btn--ghost btn--sm" id="viewExampleCopyBtn" style="padding: 2px 8px; font-size: 0.75rem;">
              <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 4px;"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              Copy Example
            </button>
          </div>
          <pre class="lib-code-content" id="viewPromptExampleContent" style="white-space: pre-wrap; font-size: 0.85rem; background: rgba(255,255,255,0.03); padding: 1rem; border-radius: 8px; border: 1px dashed var(--color-border-subtle); max-height: 30vh; overflow-y: auto; font-family: monospace; margin: 0; line-height: 1.5; color: var(--color-text-secondary);"></pre>
        </div>
        
        <div id="viewPromptTagsWrap" style="margin-top: 1.5rem; display: none; flex-wrap: wrap; gap: 6px;"></div>
      </div>
      <div class="modal-footer">
        <button class="btn btn--ghost close-modal">Close</button>
        <button class="btn btn--primary" id="viewPromptCopyBtn">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          Copy Prompt
        </button>
      </div>
    </div>
  </div>

  <!-- Toast Container -->
  <div class="toast-container" id="toastContainer"></div>

</BaseLayout>

<style is:global>
  .prompt-library-page {
    padding-top: calc(var(--header-height) + var(--space-8));
    padding-bottom: var(--space-16);
    min-height: 80vh;
  }

  .library-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  .library-title {
    font-size: var(--text-3xl);
    margin-bottom: var(--space-1);
  }
  .library-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .stat-pill {
    display: inline-block;
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-full);
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .search-wrap {
    position: relative;
    flex: 1 1 240px;
  }
  .search-icon {
    position: absolute;
    left: var(--space-3);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-tertiary);
    width: 18px;
    height: 18px;
  }
  .search-wrap .input-base {
    width: 100%;
    padding-left: 2.5rem;
  }

  .input-base {
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    color: var(--color-text-primary);
    outline: none;
    transition: border-color var(--transition-fast);
  }
  .input-base:focus {
    border-color: var(--color-accent-primary);
  }
  .textarea {
    resize: vertical;
    min-height: 120px;
    font-family: monospace;
    font-size: var(--text-sm);
  }

  .tabs {
    display: flex;
    gap: var(--space-1);
    background: var(--color-bg-elevated);
    border-radius: var(--radius-full);
    padding: var(--space-1);
    border: 1px solid var(--color-border-subtle);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .tabs::-webkit-scrollbar { display: none; }
  .tab {
    padding: var(--space-1) var(--space-4);
    border-radius: var(--radius-full);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: var(--space-2);
    white-space: nowrap;
    transition: all var(--transition-fast);
    border: none;
    background: transparent;
    cursor: pointer;
  }
  .tab.active {
    background: var(--color-bg-card);
    color: var(--color-text-primary);
    box-shadow: var(--shadow-sm);
  }
  .tab .count {
    font-size: var(--text-xs);
    opacity: 0.7;
    background: rgba(255,255,255,0.1);
    padding: 2px 6px;
    border-radius: var(--radius-full);
  }

  .toolbar-actions {
    display: flex;
    gap: var(--space-2);
    margin-left: auto;
  }

  /* Collections Section */
  .collections-section {
    margin-bottom: var(--space-8);
  }
  .collections-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--space-4);
  }
  .section-title {
    font-size: var(--text-xl);
  }
  .collections-row {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    padding-top: var(--space-4);
    padding-bottom: var(--space-8);
    scrollbar-width: none;
  }
  .collections-row::-webkit-scrollbar { display: none; }
  .collection-card {
    flex: 0 0 auto;
    width: 280px;
    min-height: 160px;
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    cursor: pointer;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 20px;
    background: linear-gradient(145deg, rgba(30,30,30,0.8), rgba(10,10,10,0.95));
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    box-shadow: 0 8px 32px rgba(0,0,0,0.3);
  }
  .collection-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.5);
    border-color: rgba(255,255,255,0.2);
  }
  .collection-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  .collection-card-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255,255,255,0.05) !important;
    border: 1px solid rgba(255,255,255,0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-primary);
  }
  .collection-card-icon svg {
    width: 20px;
    height: 20px;
  }
  .collection-card-actions {
    display: flex;
    gap: var(--space-1);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }
  .collection-card:hover .collection-card-actions { opacity: 1; }
  .collection-info {
    margin-top: var(--space-4);
  }
  .collection-name { 
    font-size: 1.25rem !important; 
    font-family: var(--font-heading);
    font-weight: 600; 
    color: #fff;
    margin: 0 0 4px 0 !important;
    line-height: 1.3;
    word-break: break-word;
    overflow-wrap: break-word;
  }
  .collection-desc {
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    margin: 0 0 8px 0;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .collection-card-count { 
    font-size: 0.875rem; 
    color: rgba(255,255,255,0.5); 
  }

  /* Collection Detail Header */
  .collection-detail-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    width: 100%;
  }
  .collection-detail-header[hidden] {
    display: none !important;
  }
  .collection-detail-top-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .collection-detail-info {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  .back-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    font-weight: 500;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }
  .back-btn:hover { color: var(--color-text-primary); }
  .collection-count { font-size: var(--text-sm); color: var(--color-text-tertiary); }
  .collection-detail-actions { display: flex; gap: var(--space-2); }

  /* Grid */
  .lib-prompt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-6);
  }
  @keyframes movingGlow {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  .lib-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    position: relative;
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 20px;
    background: linear-gradient(145deg, rgba(30,30,30,0.6), rgba(10,10,10,0.8));
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
    box-shadow: 0 8px 32px rgba(0,0,0,0.2);
    /* Create stacking context for the glow */
    z-index: 1;
  }
  
  .lib-card::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      350px circle at var(--mouse-x, -1000px) var(--mouse-y, -1000px),
      rgba(255, 255, 255, 0.1),
      transparent 80%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 1;
  }
  .lib-card.cat-personal::before { background: radial-gradient(350px circle at var(--mouse-x, -1000px) var(--mouse-y, -1000px), rgba(59,130,246,0.15), transparent 80%); }
  .lib-card.cat-selling::before { background: radial-gradient(350px circle at var(--mouse-x, -1000px) var(--mouse-y, -1000px), rgba(245,158,11,0.15), transparent 80%); }
  .lib-card.cat-both::before { background: radial-gradient(350px circle at var(--mouse-x, -1000px) var(--mouse-y, -1000px), rgba(16,185,129,0.15), transparent 80%); }

  .lib-card-header,
  .lib-code-block,
  .lib-card-footer {
    position: relative;
    z-index: 2;
    pointer-events: auto;
  }

  .lib-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(0,0,0,0.4);
    border-color: rgba(255,255,255,0.15);
  }
  .lib-card:hover::before {
    opacity: 1;
  }

  .lib-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .lib-card-title-wrap {
    flex: 1;
    min-width: 0;
  }
  .lib-card-title {
    font-size: 1.25rem;
    font-family: var(--font-heading);
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: var(--space-3);
    color: #fff;
    word-break: break-word;
  }
  .lib-card-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    min-width: 0;
