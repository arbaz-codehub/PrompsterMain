    flex-shrink: 0;
  }
</style>

<script>
  import { createBrowserClient } from '@supabase/ssr';
  
  // Basic icon strings
  const ICONS = {
    folder: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2Z"></path></svg>',
    pencil: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg>',
    trash: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path><path d="M10 11v6"></path><path d="M14 11v6"></path><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path></svg>',
    copy: '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>',
    check: '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>',
    chevronDown: '<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>'
  };

  let supabase;
  let userId = null;
  let prompts = [];
  let collections = [];
  
  let currentFilter = 'all';
  let currentCollectionId = null;
  
  // State for modals
  let editingPromptId = null;
  let editingCollectionId = null;
  let confirmAction = null;

  async function init() {
    if (!window.IS_LOGGED_IN) {
      document.getElementById('loadingState').hidden = true;
      showEmptyState("Login Required", "Please log in to use the Prompt Library.", () => {
        window.location.href = "/login?redirect=/tools/prompt-library";
      }, "Log In");
      return;
    }

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    supabase = createBrowserClient(supabaseUrl, supabaseAnonKey);

    const { data: { user } } = await supabase.auth.getUser();
    if (!user) {
      window.location.href = "/login?redirect=/tools/prompt-library";
      return;
    }
    userId = user.id;

    setupEventListeners();

    // Local Persistence
    try {
      const savedP = localStorage.getItem('lib_prompts');
      const savedC = localStorage.getItem('lib_collections');
      if (savedP) prompts = JSON.parse(savedP);
      if (savedC) collections = JSON.parse(savedC);
    } catch (e) {
      console.error("Local storage read error", e);
    }

    render();

    await loadData();
    render();
  }

  function saveToLocal() {
    try {
      localStorage.setItem('lib_prompts', JSON.stringify(prompts));
      localStorage.setItem('lib_collections', JSON.stringify(collections));
    } catch (e) {}
  }

  async function loadData() {
    try {
      const [pRes, cRes] = await Promise.all([
        supabase.from('user_prompts').select('*').eq('user_id', userId).order('updated_at', { ascending: false }),
        supabase.from('collections').select('*').eq('user_id', userId).order('created_at', { ascending: true })
      ]);
      
      if (pRes.data) {
        prompts = pRes.data;
      }
      if (cRes.data) {
        collections = cRes.data;
      }
      saveToLocal();
    } catch (err) {
      console.error("Supabase load error:", err);
      toast("Could not sync with database. Showing local offline data.");
    } finally {
      const loadingEl = document.getElementById('loadingState');
      if (loadingEl) loadingEl.hidden = true;
      render();
    }
  }

  // UUID generator fallback if not using DB side generation directly
  function uuid() {
    return crypto.randomUUID ? crypto.randomUUID() : 'id-' + Date.now();
  }

  function formatDate(isoString) {
    if (!isoString) return '';
    const d = new Date(isoString);
    return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' });
  }

  function toast(msg) {
    const container = document.getElementById('toastContainer');
    const el = document.createElement('div');
    el.className = 'toast';
    el.textContent = msg;
    container.appendChild(el);
    setTimeout(() => el.remove(), 3000);
  }

  async function copyText(text, btnEl) {
    try {
      await navigator.clipboard.writeText(text);
      btnEl.innerHTML = ICONS.check + '<span>Copied</span>';
      btnEl.classList.add('copied');
      setTimeout(() => {
        btnEl.innerHTML = ICONS.copy + '<span>Copy</span>';
        btnEl.classList.remove('copied');
      }, 2000);
    } catch (e) {
      toast('Failed to copy text.');
    }
  }

  function render() {
    // 1. Filter Prompts
    let filtered = [...prompts];
    const searchVal = document.getElementById('searchInput').value.trim().toLowerCase();
    if (searchVal) {
      filtered = filtered.filter(p => 
        p.title.toLowerCase().includes(searchVal) ||
        (p.tags && p.tags.some(t => t.toLowerCase().includes(searchVal)))
      );
    }
    
    if (currentFilter !== 'all') {
      filtered = filtered.filter(p => p.category === currentFilter);
    }

    if (currentCollectionId) {
      filtered = filtered.filter(p => p.collection_id === currentCollectionId);
    } else if (!searchVal) {
      filtered = [];
    }

    // 2. Update stats and dynamic tabs
    document.getElementById('statPill').textContent = `${prompts.length} prompt${prompts.length === 1 ? '' : 's'} saved`;
    renderTabs();

    // 3. Render Collections Row or Detail Header
    const colSection = document.getElementById('collectionsSection');
    const colHeader = document.getElementById('collectionHeader');
    
    if (currentCollectionId) {
      colSection.hidden = true;
      colHeader.hidden = false;
      const c = collections.find(c => c.id === currentCollectionId);
      if (c) {
        document.getElementById('collectionHeaderTitle').textContent = c.name;
        const count = prompts.filter(p => p.collection_id === c.id).length;
        document.getElementById('collectionHeaderCount').textContent = `${count} prompt${count === 1 ? '' : 's'}`;
      } else {
        currentCollectionId = null;
        render(); return;
      }
    } else {
      colSection.hidden = searchVal ? true : false;
      colHeader.hidden = true;
      if (!searchVal) renderCollectionsRow();
    }

    // 4. Render Grid
    const grid = document.getElementById('promptGrid');
    const emptyState = document.getElementById('emptyState');
    grid.innerHTML = '';

    if (filtered.length === 0) {
      grid.hidden = true;
      const searchValForEmpty = document.getElementById('searchInput').value.trim();
      const hasSearchOrFilter = searchValForEmpty !== '' || currentFilter !== 'all';

      if (currentCollectionId && prompts.filter(p => p.collection_id === currentCollectionId).length === 0) {
        emptyState.hidden = false;
        showEmptyState("Collection is empty", "Add a prompt here or move an existing one into this collection.", () => openAddPromptModal(null, currentCollectionId), "Add to collection");
      } else if (prompts.length === 0) {
        emptyState.hidden = false;
        showEmptyState("Your library is empty", "Add prompts to organize, reuse, and sell them.", () => openAddPromptModal(), "Add first prompt");
      } else if (hasSearchOrFilter) {
        emptyState.hidden = false;
        showEmptyState("No matching prompts", "Try a different search term or filter.", () => {
          document.getElementById('searchInput').value = '';
          currentFilter = 'all';
          render();
        }, "Clear filters");
      } else {
        emptyState.hidden = true;
      }
    } else {
      emptyState.hidden = true;
      grid.hidden = false;
      filtered.forEach(p => {
        grid.appendChild(buildPromptCard(p));
      });
    }
  }

  function renderTabs() {
    const tabsContainer = document.getElementById('filterTabs');
    if (!tabsContainer) return;
    
    // Get unique categories, ignore empty/null
    const categories = Array.from(new Set(prompts.map(p => p.category).filter(Boolean))).sort();
    
    tabsContainer.innerHTML = '';
    
    // 'All' Tab
    const btnAll = document.createElement('button');
    btnAll.className = `tab ${currentFilter === 'all' ? 'active' : ''}`;
    btnAll.dataset.filter = 'all';
    btnAll.innerHTML = `All <span class="count">${prompts.length}</span>`;
    btnAll.onclick = () => { currentFilter = 'all'; render(); };
    tabsContainer.appendChild(btnAll);

    // Dynamic Category Tabs
    categories.forEach(cat => {
      const btn = document.createElement('button');
      btn.className = `tab ${currentFilter === cat ? 'active' : ''}`;
      btn.dataset.filter = cat;
      const count = prompts.filter(p => p.category === cat).length;
      btn.innerHTML = `${cat} <span class="count">${count}</span>`;
      btn.onclick = () => { currentFilter = cat; render(); };
      tabsContainer.appendChild(btn);
    });
    
    // Update Datalist in the Add Modal
    const datalist = document.getElementById('categoryList');
    if (datalist) {
      datalist.innerHTML = '';
      categories.forEach(cat => {
        const option = document.createElement('option');
        option.value = cat;
        datalist.appendChild(option);
      });
    }
  }

  function showEmptyState(title, text, actionFn, actionText) {
    const content = document.getElementById('emptyStateContent');
    content.innerHTML = `<h3>${title}</h3><p>${text}</p>`;
    const btn = document.createElement('button');
    btn.className = 'btn btn--primary';
    btn.textContent = actionText;
    btn.onclick = actionFn;
    content.appendChild(btn);
  }

  function renderCollectionsRow() {
    const row = document.getElementById('collectionsRow');
    row.innerHTML = '';
    if (collections.length === 0) {
      row.innerHTML = `<span style="color:var(--color-text-tertiary); font-size:var(--text-sm);">No collections yet.</span>`;
      return;
    }
    collections.forEach(c => {
      const count = prompts.filter(p => p.collection_id === c.id).length;
      const card = document.createElement('div');
      card.className = 'collection-card';
      card.onclick = () => { currentCollectionId = c.id; render(); };
      
      card.innerHTML = `
        <div class="collection-top">
          <div class="collection-card-icon">${ICONS.folder}</div>
          <div class="collection-card-actions">
            <button class="icon-btn" title="Rename" onclick="event.stopPropagation(); window.openEditCollectionModal('${c.id}')">${ICONS.pencil}</button>
            <button class="icon-btn" title="Delete" onclick="event.stopPropagation(); window.openConfirmDeleteCollection('${c.id}')">${ICONS.trash}</button>
          </div>
        </div>
        <div class="collection-info">
          <div class="collection-name">${c.name}</div>
          ${c.description ? `<div class="collection-desc">${c.description}</div>` : ''}
          <span class="collection-card-count">${count} prompt${count===1?'':'s'}</span>
        </div>
      `;
      row.appendChild(card);
    });
  }

  function buildPromptCard(p) {
    const card = document.createElement('div');
    card.className = `lib-card glass-card cat-${p.category}`;
    
    card.onmousemove = (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      card.style.setProperty('--mouse-x', `${x}px`);
      card.style.setProperty('--mouse-y', `${y}px`);
    };
    
    // Header
    const header = document.createElement('div');
    header.className = 'lib-card-header';
    
    const titleWrap = document.createElement('div');
    titleWrap.className = 'lib-card-title-wrap';
    const title = document.createElement('h3');
    title.className = 'lib-card-title';
    title.textContent = p.title;
    
    const badges = document.createElement('div');
    badges.className = 'lib-card-badges';
    const catBadge = document.createElement('span');
    const catClass = (p.category || 'personal').toLowerCase();
    catBadge.className = `badge badge-${catClass}`;
    catBadge.textContent = p.category || 'Uncategorized';
    badges.appendChild(catBadge);
    if (p.example) {
      const exBadge = document.createElement('span');
      exBadge.className = 'badge badge-both';
      exBadge.textContent = 'Has Example';
      badges.appendChild(exBadge);
    }
    
    titleWrap.appendChild(title);
    titleWrap.appendChild(badges);
    
    if (p.price) {
      const priceBadge = document.createElement('div');
      priceBadge.className = 'badge-price';
      priceBadge.textContent = p.price;
      titleWrap.appendChild(priceBadge);
    }
    
    const actions = document.createElement('div');
    actions.className = 'lib-card-actions';
    const editBtn = document.createElement('button');
    editBtn.className = 'icon-btn'; editBtn.innerHTML = ICONS.pencil;
    editBtn.onclick = () => openAddPromptModal(p.id);
    const delBtn = document.createElement('button');
    delBtn.className = 'icon-btn'; delBtn.innerHTML = ICONS.trash;
    delBtn.onclick = () => window.openConfirmDeletePrompt(p.id, p.title);
    actions.appendChild(editBtn);
    actions.appendChild(delBtn);
    
    header.appendChild(titleWrap);
    header.appendChild(actions);
    card.appendChild(header);

    // Code Block
    const codeBlock = document.createElement('div');
    codeBlock.className = 'lib-code-block';
    
    const codeHeader = document.createElement('div');
    codeHeader.className = 'lib-code-header';
    codeHeader.innerHTML = '<span>Prompt</span>';
    const copyBtn = document.createElement('button');
    copyBtn.className = 'lib-copy-btn';
    copyBtn.innerHTML = ICONS.copy + '<span>Copy</span>';
    copyBtn.onclick = () => copyText(p.content, copyBtn);
    codeHeader.appendChild(copyBtn);
    
    const codeScroll = document.createElement('div');
    codeScroll.className = 'lib-code-scroll';
    const pre = document.createElement('pre');
    pre.className = 'lib-code-content';
    pre.textContent = p.content;
    codeScroll.appendChild(pre);
    
    const toggleBtn = document.createElement('button');
    toggleBtn.className = 'lib-toggle-btn';
    toggleBtn.hidden = true;
    toggleBtn.innerHTML = '<span>View full prompt</span>';
    toggleBtn.onclick = () => window.openViewPromptModal(p);

    codeBlock.appendChild(codeHeader);
    codeBlock.appendChild(codeScroll);
    codeBlock.appendChild(toggleBtn);
    card.appendChild(codeBlock);

    // EXPERIMENT: Marketplace Pack Link
    if (p.pack_id) {
      const packCard = document.createElement('div');
      packCard.className = 'prompt-pack-card';
      
      const imgWrap = document.createElement('div');
      imgWrap.className = 'prompt-pack-card__image-wrap';
      if (p.pack_image_url) {
        const img = document.createElement('img');
        img.src = p.pack_image_url;
        img.alt = p.pack_title || 'Pack';
        img.className = 'prompt-pack-card__image';
        imgWrap.appendChild(img);
      } else {
        const ph = document.createElement('div');
        ph.className = 'prompt-pack-card__placeholder';
        ph.textContent = '📦';
        imgWrap.appendChild(ph);
      }
      
      const contentWrap = document.createElement('div');
      contentWrap.className = 'prompt-pack-card__content';
      const label = document.createElement('span');
      label.className = 'prompt-pack-card__label';
      label.textContent = 'Part of Marketplace Pack';
      const pTitle = document.createElement('h4');
      pTitle.className = 'prompt-pack-card__title';
      pTitle.textContent = p.pack_title || 'Premium Collection';
      contentWrap.appendChild(label);
      contentWrap.appendChild(pTitle);
      
      const pBtn = document.createElement('a');
      pBtn.className = 'btn btn--primary btn--sm prompt-pack-card__btn';
      pBtn.href = `/packs/${p.pack_id}`;
      pBtn.textContent = 'View Pack \u2192';
      
      packCard.appendChild(imgWrap);
      packCard.appendChild(contentWrap);
      packCard.appendChild(pBtn);
      
      card.appendChild(packCard);
    }
    // END EXPERIMENT

    // Footer
    const footer = document.createElement('div');
    footer.className = 'lib-card-footer';
    const footerLeft = document.createElement('div');
    if (!currentCollectionId && p.collection_id) {
      const c = collections.find(x => x.id === p.collection_id);
      if (c) {
        const colBtn = document.createElement('button');
        colBtn.className = 'col-tag';
        colBtn.innerHTML = ICONS.folder + '<span>' + c.name + '</span>';
        colBtn.onclick = () => { currentCollectionId = c.id; render(); };
        footerLeft.appendChild(colBtn);
      }
    }
    const ts = document.createElement('span');
    ts.className = 'lib-timestamp';
    ts.textContent = 'Updated ' + formatDate(p.updated_at);
    
    footer.appendChild(footerLeft);
    footer.appendChild(ts);
    card.appendChild(footer);

    // More reliable overflow check based on text length/newlines instead of DOM timings
    const lineCount = (p.content.match(/\n/g) || []).length;
    if (p.content.length > 250 || lineCount > 5) {
      codeScroll.classList.add('has-overflow');
      toggleBtn.hidden = false;
    }

    return card;
  }

  // Set up listeners
  function setupEventListeners() {
    document.getElementById('searchInput').addEventListener('input', render);
    
    document.querySelectorAll('.tab').forEach(t => {
      t.addEventListener('click', (e) => {
        const btn = e.currentTarget;
        currentFilter = btn.dataset.filter;
        render();
      });
    });


    document.getElementById('newPromptBtn').addEventListener('click', () => openAddPromptModal());
    document.getElementById('newCollectionBtn').addEventListener('click', () => window.openCollectionModal());
    document.getElementById('backToAllBtn').addEventListener('click', () => { currentCollectionId = null; render(); });
    document.getElementById('renameCollectionBtn').addEventListener('click', () => window.openCollectionModal(currentCollectionId));
    document.getElementById('deleteCollectionBtn').addEventListener('click', () => window.openConfirmDeleteCollection(currentCollectionId));

    document.querySelectorAll('.close-modal').forEach(btn => {
      btn.addEventListener('click', closeModals);
    });
    
    document.getElementById('fieldContent').addEventListener('input', (e) => {
      document.getElementById('charCount').textContent = e.target.value.length + ' characters';
    });

    document.getElementById('savePromptBtn').addEventListener('click', savePrompt);
    document.getElementById('saveCollectionBtn').addEventListener('click', saveCollection);
    document.getElementById('confirmActionBtn').addEventListener('click', executeConfirm);

    // Export/Import
    document.getElementById('exportBtn').addEventListener('click', () => {
      const data = { version: 1, exportedAt: new Date().toISOString(), prompts, collections };
      const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = 'prompster-library-backup.json';
      a.click(); URL.revokeObjectURL(url);
    });

    document.getElementById('importBtn').addEventListener('click', () => document.getElementById('importFile').click());
    document.getElementById('importFile').addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if(!file) return;
      try {
        const text = await file.text();
        const data = JSON.parse(text);
        let importedP = 0; let importedC = 0;
        
        // Very basic import logic (syncs to DB)
        if (data.collections && Array.isArray(data.collections)) {
          for (const c of data.collections) {
            if(!collections.find(ext => ext.name === c.name)) {
              const newC = { user_id: userId, name: c.name };
              const { data: ret } = await supabase.from('collections').insert(newC).select().single();
              if (ret) { collections.push(ret); importedC++; }
            }
          }
        }
        
        if (data.prompts && Array.isArray(data.prompts)) {
          for (const p of data.prompts) {
            // Check for dupe title
            if(!prompts.find(ext => ext.title === p.title)) {
               // Try to map collection id by name if it existed in exported data
               let cId = null;
               if (p.collection_id && data.collections) {
                 const oldC = data.collections.find(c => c.id === p.collection_id);
                 if (oldC) {
                   const matchedC = collections.find(c => c.name === oldC.name);
                   if (matchedC) cId = matchedC.id;
                 }
               }
               
               const newP = {
                 user_id: userId,
                 title: p.title, content: p.content, category: p.category || 'personal',
                 price: p.price || null, tags: p.tags || [], collection_id: cId
               };
               const { data: ret } = await supabase.from('user_prompts').insert(newP).select().single();
               if (ret) { prompts.push(ret); importedP++; }
            }
          }
        }
        toast(`Imported ${importedP} prompts, ${importedC} collections.`);
        saveToLocal();
        render();
      } catch (err) {
        toast('Failed to import file.');
      }
      e.target.value = '';
    });
  }

  function closeModals() {
    document.querySelectorAll('.modal-overlay').forEach(m => m.hidden = true);
    editingPromptId = null;
    editingCollectionId = null;
    confirmAction = null;
  }

  // --- Prompts Logic ---
  function openAddPromptModal(id = null, presetColId = null) {
    editingPromptId = id;
    document.getElementById('promptModalTitle').textContent = id ? 'Edit Prompt' : 'Add Prompt';
    document.getElementById('fieldTitleWrap').classList.remove('invalid');
    document.getElementById('fieldContentWrap').classList.remove('invalid');
    document.getElementById('fieldCollectionWrap').classList.remove('invalid');
    
    const colSelect = document.getElementById('fieldCollection');
    colSelect.innerHTML = '<option value="" disabled selected>Select a collection</option>';
    collections.forEach(c => {
      const opt = document.createElement('option');
      opt.value = c.id; opt.textContent = c.name;
      colSelect.appendChild(opt);
    });

    if (id) {
      const p = prompts.find(x => x.id === id);
      document.getElementById('fieldTitle').value = p.title;
      document.getElementById('fieldContent').value = p.content;
      document.getElementById('fieldExample').value = p.example || '';
      document.getElementById('fieldCategory').value = p.category || '';
      document.getElementById('fieldPrice').value = p.price || '';
      document.getElementById('fieldTags').value = (p.tags || []).join(', ');
      colSelect.value = p.collection_id || '';
    } else {
      document.getElementById('fieldTitle').value = '';
      document.getElementById('fieldContent').value = '';
      document.getElementById('fieldExample').value = '';
      document.getElementById('fieldCategory').value = 'Personal';
      document.getElementById('fieldPrice').value = '';
      document.getElementById('fieldTags').value = '';
      colSelect.value = presetColId || currentCollectionId || '';
    }
    
    document.getElementById('charCount').textContent = document.getElementById('fieldContent').value.length + ' characters';
    document.getElementById('promptModal').hidden = false;
  }

  async function savePrompt() {
    const title = document.getElementById('fieldTitle').value.trim();
    const content = document.getElementById('fieldContent').value.trim();
    const example = document.getElementById('fieldExample').value.trim() || null;
    
    const collection_id = document.getElementById('fieldCollection').value || null;

    document.getElementById('fieldTitleWrap').classList.toggle('invalid', !title);
    document.getElementById('fieldContentWrap').classList.toggle('invalid', !content);
    document.getElementById('fieldCollectionWrap').classList.toggle('invalid', !collection_id);
    if (!title || !content || !collection_id) return;

    const tags = document.getElementById('fieldTags').value.split(',').map(t => t.trim()).filter(Boolean);
    const category = document.getElementById('fieldCategory').value.trim() || 'Personal';
    const price = document.getElementById('fieldPrice').value.trim() || null;
    const updated_at = new Date().toISOString();

    const payload = { user_id: userId, title, content, example, category, price, tags, collection_id, updated_at };

    if (editingPromptId) {
      // Optimistic
      const idx = prompts.findIndex(p => p.id === editingPromptId);
      if (idx > -1) prompts[idx] = { ...prompts[idx], ...payload };
      saveToLocal();
      render(); closeModals();
      // DB
      await supabase.from('user_prompts').update(payload).eq('id', editingPromptId);
      toast('Prompt updated');
    } else {
      // Optimistic with temp ID
      const tempId = uuid();
      const newPrompt = { id: tempId, created_at: updated_at, ...payload };
      prompts.unshift(newPrompt);
      saveToLocal();
      render(); closeModals();
      // DB
      const { data } = await supabase.from('user_prompts').insert(payload).select().single();
      if (data) {
        const idx = prompts.findIndex(p => p.id === tempId);
        if (idx > -1) { prompts[idx] = data; saveToLocal(); render(); }
      }
      toast('Prompt saved');
    }
  }

  window.openConfirmDeletePrompt = function(id, title) {
    document.getElementById('confirmTitle').textContent = 'Delete Prompt';
    document.getElementById('confirmMessage').textContent = `Are you sure you want to delete "${title}"? This cannot be undone.`;
    confirmAction = async () => {
      // Optimistic
      prompts = prompts.filter(p => p.id !== id);
      saveToLocal();
      render(); closeModals();
      // DB
      await supabase.from('user_prompts').delete().eq('id', id);
      toast('Prompt deleted');
    };
    document.getElementById('confirmModal').hidden = false;
  }

  async function saveCollection() {
    const name = document.getElementById('collectionNameInput').value.trim();
    const desc = document.getElementById('collectionDescInput').value.trim();
    if (!name) {
      document.getElementById('collectionNameWrap').classList.add('invalid');
      return;
    }
    document.getElementById('collectionNameWrap').classList.remove('invalid');

    if (editingCollectionId) {
      // Optimistic
      const c = collections.find(x => x.id === editingCollectionId);
      if (c) { c.name = name; c.description = desc; }
      saveToLocal();
      render(); closeModals();
      // DB
      try {
        await supabase.from('collections').update({ name, description: desc }).eq('id', editingCollectionId);
        toast('Collection updated');
      } catch (e) { toast('Error updating collection'); }
    } else {
      const payload = { user_id: userId, name, description: desc };
      const tempId = uuid();
      collections.push({ id: tempId, created_at: new Date().toISOString(), ...payload });
      saveToLocal();
      render(); closeModals();
      
      try {
        const { data } = await supabase.from('collections').insert(payload).select().single();
        if (data) {
          const idx = collections.findIndex(c => c.id === tempId);
          if (idx > -1) { collections[idx] = data; saveToLocal(); render(); }
        }
        toast('Collection created');
      } catch (e) { toast('Error creating collection'); }
    }
  }

  // --- Collections Logic ---
  window.openCollectionModal = function() {
    editingCollectionId = null;
    document.getElementById('collectionModalTitle').textContent = 'New Collection';
    document.getElementById('collectionNameInput').value = '';
    document.getElementById('collectionDescInput').value = '';
    document.getElementById('collectionModal').hidden = false;
  };

  window.openEditCollectionModal = function(id) {
    const c = collections.find(x => x.id === id);
    if (!c) return;
    editingCollectionId = id;
    document.getElementById('collectionModalTitle').textContent = 'Edit Collection';
    document.getElementById('collectionNameInput').value = c.name;
    document.getElementById('collectionDescInput').value = c.description || '';
    document.getElementById('collectionModal').hidden = false;
  }

  window.openConfirmDeleteCollection = function(id) {
    const c = collections.find(x => x.id === id);
    document.getElementById('confirmTitle').textContent = 'Delete Collection';
    document.getElementById('confirmMessage').textContent = `Are you sure you want to delete "${c.name}"? The prompts inside will NOT be deleted, just ungrouped.`;
    confirmAction = async () => {
      // Optimistic
      collections = collections.filter(x => x.id !== id);
      prompts.forEach(p => { if (p.collection_id === id) p.collection_id = null; });
      if (currentCollectionId === id) currentCollectionId = null;
      saveToLocal();
      render(); closeModals();
      
      // DB
      await supabase.from('user_prompts').update({ collection_id: null }).eq('collection_id', id);
      await supabase.from('collections').delete().eq('id', id);
      toast('Collection deleted');
    };
    document.getElementById('confirmModal').hidden = false;
  }

  window.openViewPromptModal = function(p) {
    document.getElementById('viewPromptTitle').textContent = p.title;
    document.getElementById('viewPromptContent').textContent = p.content;
    const copyBtn = document.getElementById('viewPromptCopyBtn');
    copyBtn.onclick = () => copyText(p.content, copyBtn);
    
    const exWrap = document.getElementById('viewPromptExampleWrap');
    if (p.example) {
      exWrap.style.display = 'block';
      document.getElementById('viewPromptExampleContent').textContent = p.example;
      const exCopyBtn = document.getElementById('viewExampleCopyBtn');
      exCopyBtn.onclick = () => copyText(p.example, exCopyBtn);
    } else {
      exWrap.style.display = 'none';
    }
    
    const tagsWrap = document.getElementById('viewPromptTagsWrap');
    tagsWrap.innerHTML = '';
    if (p.tags && p.tags.length > 0) {
      p.tags.forEach(t => {
        const span = document.createElement('span');
        span.className = 'tag-badge';
        span.textContent = '#' + t;
        tagsWrap.appendChild(span);
      });
      tagsWrap.style.display = 'flex';
    } else {
      tagsWrap.style.display = 'none';
    }
    
    document.getElementById('viewPromptModal').hidden = false;
  };

  function executeConfirm() {
    if (confirmAction) confirmAction();
  }

  // Boot
  document.addEventListener("astro:page-load", init);
</script>
