---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { createSupabaseClient } from "../lib/supabase";

const adminPassword = import.meta.env.ADMIN_PASSWORD || process.env.ADMIN_PASSWORD;

// Basic Auth via Cookie
let isAuthenticated = Astro.cookies.get('prompster_admin_auth')?.value === adminPassword;
let error = false;

if (Astro.request.method === 'POST') {
  const data = await Astro.request.formData();
  const password = data.get('password');
  if (password === adminPassword) {
    Astro.cookies.set('prompster_admin_auth', password, { path: '/', maxAge: 86400, secure: import.meta.env.PROD, sameSite: 'lax' });
    return Astro.redirect('/admin');
  } else {
    error = true;
  }
}

// Fetch data if authenticated
let waitlist: any[] = [];
let requests: any[] = [];

if (isAuthenticated) {
  const supabase = createSupabaseClient(Astro.cookies, Astro.request);
  const [{ data: waitlistData }, { data: requestData }] = await Promise.all([
    supabase.from('waitlist_emails').select('*').order('created_at', { ascending: false }),
    supabase.from('tool_requests').select('*').order('created_at', { ascending: false })
  ]);
  
  waitlist = waitlistData || [];
  requests = requestData || [];
}
---

<BaseLayout
  title="Admin Dashboard | Prompster"
  noIndex={true}
>
  <Header slot="header" />

  <main class="container" style="padding-top: 100px; padding-bottom: 100px; min-height: 80vh;">
    {!isAuthenticated ? (
      <div style="max-width: 400px; margin: 0 auto; background: var(--color-bg-card); padding: 2rem; border-radius: var(--radius-xl); border: 1px solid var(--color-border-subtle); text-align: center;">
        <h1 style="font-size: 1.5rem; margin-bottom: 1.5rem; font-family: 'Unbounded', sans-serif;">Admin Login</h1>
        {error && <p style="color: var(--color-accent-rose); margin-bottom: 1rem;">Incorrect password.</p>}
        <form method="POST" style="display: flex; flex-direction: column; gap: 1rem;">
          <input type="password" name="password" placeholder="Admin Password" required style="background: var(--color-bg-elevated); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); padding: 0.75rem 1rem; color: var(--color-text-primary); outline: none; transition: border-color var(--transition-fast);" />
          <button type="submit" class="btn btn--primary" style="justify-content: center;">Login</button>
        </form>
      </div>
    ) : (
      <div>
        <h1 style="font-size: 2rem; font-family: 'Unbounded', sans-serif; margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center;">
          Admin Dashboard
        </h1>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
          <!-- Waitlist Table -->
          <div style="background: var(--color-bg-card); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-xl); overflow: hidden;">
            <div style="padding: 1.5rem; border-bottom: 1px solid var(--color-border-subtle); background: var(--color-bg-elevated); display: flex; justify-content: space-between; align-items: center;">
              <h2 style="font-size: 1.25rem; font-weight: 700;">Marketplace Waitlist</h2>
              <span style="background: var(--color-accent-primary); color: #000; padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600;">{waitlist.length}</span>
            </div>
            <div style="padding: 1.5rem; overflow-x: auto; max-height: 500px; overflow-y: auto;">
              {waitlist.length === 0 ? (
                <p style="color: var(--color-text-muted); text-align: center;">No emails yet.</p>
              ) : (
                <table style="width: 100%; border-collapse: collapse; text-align: left;">
                  <thead>
                    <tr>
                      <th style="padding-bottom: 1rem; color: var(--color-text-secondary); font-weight: 600;">Email</th>
                      <th style="padding-bottom: 1rem; color: var(--color-text-secondary); font-weight: 600; text-align: right;">Date</th>
                    </tr>
                  </thead>
                  <tbody>
                    {waitlist.map(w => (
                      <tr style="border-top: 1px solid var(--color-border-subtle);">
                        <td style="padding: 1rem 0;">{w.email}</td>
                        <td style="padding: 1rem 0; text-align: right; color: var(--color-text-muted); font-size: 0.875rem;">{new Date(w.created_at).toLocaleDateString()}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
            </div>
          </div>

          <!-- Tool Requests Table -->
          <div style="background: var(--color-bg-card); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-xl); overflow: hidden;">
            <div style="padding: 1.5rem; border-bottom: 1px solid var(--color-border-subtle); background: var(--color-bg-elevated); display: flex; justify-content: space-between; align-items: center;">
              <h2 style="font-size: 1.25rem; font-weight: 700;">Tool Requests</h2>
              <span style="background: var(--color-accent-emerald); color: #000; padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: 0.875rem; font-weight: 600;">{requests.length}</span>
            </div>
            <div style="padding: 1.5rem; overflow-x: auto; max-height: 500px; overflow-y: auto;">
              {requests.length === 0 ? (
                <p style="color: var(--color-text-muted); text-align: center;">No requests yet.</p>
              ) : (
                <table style="width: 100%; border-collapse: collapse; text-align: left;">
                  <thead>
                    <tr>
                      <th style="padding-bottom: 1rem; color: var(--color-text-secondary); font-weight: 600;">Idea</th>
                      <th style="padding-bottom: 1rem; color: var(--color-text-secondary); font-weight: 600;">Contact</th>
                    </tr>
                  </thead>
                  <tbody>
                    {requests.map(r => (
                      <tr style="border-top: 1px solid var(--color-border-subtle);">
                        <td style="padding: 1rem 1rem 1rem 0; max-width: 250px; line-height: 1.5;">{r.idea_description}</td>
                        <td style="padding: 1rem 0; color: var(--color-text-muted); font-size: 0.875rem;">{r.email || 'Anonymous'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              )}
            </div>
          </div>
        </div>
      </div>
    )}
  </main>

  <Footer slot="footer" />
</BaseLayout>
