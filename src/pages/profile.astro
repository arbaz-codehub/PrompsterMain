---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { createSupabaseClient } from '../lib/supabase';

const supabase = createSupabaseClient(Astro.cookies, Astro.request);
const user = Astro.locals.user;

if (!user) {
  return Astro.redirect('/login');
}

// Fetch user profile data (email, role)
const { data: profile } = await supabase
  .from('user_profiles')
  .select('*')
  .eq('id', user.id)
  .single();

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  if (formData.has('logout')) {
    return Astro.redirect('/api/auth/logout');
  }
}
---

<BaseLayout title="My Dashboard" description="Manage your Prompster profile and favourites.">
  <Header slot="header" />

  <div class="container" style="max-width: 1200px; margin: calc(var(--header-height) + 3rem) auto 5rem; padding: 0 var(--space-4);">
    <div style="display: grid; grid-template-columns: 320px 1fr; gap: 3rem; align-items: start;" class="dashboard-grid">
      
      <!-- Left Column: User Identity -->
      <aside class="dashboard-sidebar glass-card" style="border-radius: var(--radius-2xl); overflow: hidden; position: sticky; top: calc(var(--header-height) + 2rem);">
        <!-- Banner Background -->
        <div style="height: 120px; width: 100%; background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(244, 63, 94, 0.2)); border-bottom: 1px solid var(--color-border-subtle);"></div>
        
        <!-- Avatar -->
        <div style="display: flex; flex-direction: column; align-items: center; text-align: center; margin-top: -50px; padding: 0 1.5rem 2rem;">
          <div style="width: 100px; height: 100px; border-radius: 50%; background: var(--gradient-primary); display: flex; align-items: center; justify-content: center; font-size: 3.5rem; border: 4px solid var(--color-bg-card); box-shadow: 0 8px 24px rgba(0,0,0,0.5); margin-bottom: 1rem; z-index: 2; position: relative;">
            <span style="font-weight: 800; color: white; line-height: 1; margin-top: 4px;">{user.email ? user.email.charAt(0).toUpperCase() : 'U'}</span>
          </div>
          <h2 style="font-size: var(--text-xl); font-weight: 700; margin-bottom: 0.5rem; word-break: break-all;">
            {user.user_metadata?.full_name || profile?.full_name || (user.email?.split('@')[0] || 'User')}
          </h2>
          <p style="color: var(--color-text-secondary); display: inline-flex; align-items: center; gap: 0.5rem; background: rgba(255,255,255,0.03); padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: var(--text-sm); border: 1px solid var(--color-border-subtle); margin-bottom: 2rem;">
            {user.email || 'No email provided'}
          </p>

          <div style="width: 100%; display: flex; flex-direction: column; gap: 1rem;">
            <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--color-border-subtle); border-radius: var(--radius-lg); padding: 1rem; text-align: left; display: flex; justify-content: space-between; align-items: center;">
              <span style="color: var(--color-text-secondary); font-size: var(--text-sm);">Member Since</span>
              <strong style="color: var(--color-text-primary);">{new Date(user.created_at).toLocaleDateString(undefined, { month: 'short', year: 'numeric' })}</strong>
            </div>
            
            <a href="/settings" class="btn" style="width: 100%; display: flex; justify-content: center; gap: 0.5rem; background: rgba(255,255,255,0.05); border: 1px solid var(--color-border-subtle); transition: background 0.2s;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
              </svg>
              Settings
            </a>

            <form method="POST" id="logout-form" style="width: 100%;" data-astro-reload>
              <input type="hidden" name="logout" value="true" />
              <button type="submit" id="logout-btn" class="btn btn--danger" style="width: 100%; display: flex; justify-content: center; gap: 0.5rem; background: rgba(244, 63, 94, 0.1); color: var(--color-accent-rose); border: 1px solid rgba(244, 63, 94, 0.2);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                  <polyline points="16 17 21 12 16 7"></polyline>
                  <line x1="21" y1="12" x2="9" y2="12"></line>
                </svg>
                Log Out
              </button>
            </form>
          </div>
        </div>
      </aside>

      <!-- Right Column: Favourites Masonry Grid -->
      <main class="dashboard-main">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem;">
          <h1 style="font-size: var(--text-3xl); font-weight: 800; margin: 0; display: flex; align-items: center; gap: 0.75rem;">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="var(--color-accent-rose)" stroke="var(--color-accent-rose)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            My Favourites
          </h1>
          <div style="display: flex; align-items: center; gap: 0.5rem; background: var(--color-bg-secondary); padding: 0.25rem 0.75rem; border-radius: var(--radius-full); border: 1px solid var(--color-border-subtle);">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--color-text-secondary)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            <select id="category-filter" style="background: transparent; border: none; color: var(--color-text-primary); font-size: var(--text-sm); outline: none; cursor: pointer; padding: 0.25rem;">
              <option value="All" style="background: var(--color-bg-elevated, #1e293b); color: var(--color-text-primary, #ffffff);">All Categories</option>
            </select>
          </div>
        </div>
        
        <div id="favorites-loading" style="text-align: center; padding: 4rem 0; color: var(--color-text-secondary);">
          <svg width="32" height="32" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" style="animation: spin 1s linear infinite; margin-bottom: 1rem; color: var(--color-accent-primary);">
            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" fill="none" stroke-dasharray="31.4 31.4" stroke-linecap="round" />
          </svg>
          <p>Loading favourites...</p>
        </div>

        <div id="favorites-empty" style="display: none; text-align: center; padding: 4rem 0; background: var(--color-bg-secondary); border-radius: var(--radius-2xl); border: 1px dashed var(--color-border-subtle);">
          <p style="color: var(--color-text-secondary); font-size: var(--text-lg); margin-bottom: 1rem;">No favourites saved yet.</p>
          <a href="/" class="btn btn--primary">Explore Prompts</a>
        </div>

        <div class="masonry-grid prompt-grid stagger-children" id="favorites-grid" style="display: none; opacity: 0; transition: opacity 0.5s ease;"></div>
      </main>

    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>

<style>
  @media (max-width: 900px) {
    .dashboard-grid {
      grid-template-columns: 1fr !important;
    }
    .dashboard-sidebar {
      position: relative !important;
      top: 0 !important;
    }
  }
</style>

<script is:inline>
  document.addEventListener('astro:page-load', async () => {
    const grid = document.getElementById('favorites-grid');
    const loading = document.getElementById('favorites-loading');
    const empty = document.getElementById('favorites-empty');
    const filter = document.getElementById('category-filter');

    if (!grid || !loading || !empty) return;

    const savedIds = JSON.parse(localStorage.getItem('favourites') || '[]');

    if (savedIds.length === 0) {
      loading.style.display = 'none';
      empty.style.display = 'block';
      return;
    }

    try {
      const res = await fetch('/api/favorites?expand=true');
      const allPrompts = await res.json();

      if (!allPrompts || allPrompts.length === 0) {
        loading.style.display = 'none';
        empty.style.display = 'block';
        return;
      }

      // Populate filter categories
      const categories = [...new Set(allPrompts.map(p => p.category || 'Other'))].sort();
      if (filter) {
        categories.forEach(cat => {
          const opt = document.createElement('option');
          opt.value = cat;
          opt.textContent = cat;
          opt.style.background = 'var(--color-bg-elevated, #1e293b)';
          opt.style.color = 'var(--color-text-primary, #ffffff)';
          filter.appendChild(opt);
        });

        filter.addEventListener('change', (e) => {
          const selected = e.target.value;
          const filtered = selected === 'All' ? allPrompts : allPrompts.filter(p => (p.category || 'Other') === selected);
          renderGrid(filtered);
        });
      }

      function renderGrid(prompts) {
        let html = '';
        for (const p of prompts) {
          let imageUrl = p.images[0] || 'https://picsum.photos/seed/default/800/600';
          if (imageUrl.includes('unsplash.com')) imageUrl += '&fm=webp&q=80&w=600';

          html += `
            <a href="/prompt/${p.slug}" class="prompt-card animate-fade-in-up" id="card-${p.id}" title="${p.title} - ${p.category}">
              <div class="prompt-card__image-wrap">
                <img src="${imageUrl}" alt="${p.title}" class="prompt-card__image" loading="lazy" decoding="async" />
                
                <div class="prompt-card__top-actions">
                  <button class="favorite-btn is-favorite" data-prompt-id="${p.id}" aria-label="Save to Favourites" style="border-color: var(--color-accent-rose); color: var(--color-accent-rose);" data-fav-initialized="true">
                    <svg class="heart-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                    </svg>
                  </button>
                </div>
              </div>
            </a>
          `;
        }

        grid.innerHTML = html;
        grid.style.display = 'block'; // masonry-grid uses columns
        void grid.offsetWidth; // trigger reflow
        grid.style.opacity = '1';

        // Re-attach favorite logic
        grid.querySelectorAll('.favorite-btn').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();
            const id = btn.getAttribute('data-prompt-id');
            let currentSaved = JSON.parse(localStorage.getItem('favourites') || '[]');
            
            if (currentSaved.includes(id)) {
              currentSaved = currentSaved.filter(savedId => savedId !== id);
              localStorage.setItem('favourites', JSON.stringify(currentSaved));
              
              const card = document.getElementById(`card-${id}`);
              if (card) {
                card.style.transform = 'scale(0.8)';
                card.style.opacity = '0';
                setTimeout(() => {
                  card.remove();
                  // Remove from in-memory array too so it doesn't reappear on filter
                  const idx = allPrompts.findIndex(item => item.id === id);
                  if (idx > -1) allPrompts.splice(idx, 1);
                  
                  if (grid.children.length === 0) {
                    grid.style.display = 'none';
                    empty.style.display = 'block';
                  }
                }, 300);
              }

              try {
                await fetch('/api/favorites', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ promptId: id })
                });
              } catch (err) {
                console.error('Failed to sync unfavourite to cloud');
              }
            }
          });
        });
      }

      // Initial render
      loading.style.display = 'none';
      renderGrid(allPrompts);

    } catch (e) {
      console.error('Failed to fetch favourites', e);
      loading.innerHTML = '<p style="color: var(--color-accent-rose)">Failed to load favourites. Please try again.</p>';
    }
  });
</script>
