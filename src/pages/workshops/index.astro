---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { createSupabaseClient } from "../../lib/supabase";

const siteUrl = import.meta.env.SITE_URL || "https://prompster.art";

const supabase = createSupabaseClient(Astro.cookies, Astro.request);

const { data: workshops } = await supabase
  .from("workshops")
  .select("*")
  .order("scheduled_date", { ascending: true });

const now = new Date();
const upcomingWorkshops = workshops?.filter(w => new Date(w.scheduled_date) >= now) || [];
const pastWorkshops = workshops?.filter(w => new Date(w.scheduled_date) < now) || [];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "EventSeries",
  name: "AI Workshops — Prompster",
  description: "Learn generative AI, prompting techniques, and AI tools through interactive workshops.",
  url: `${siteUrl}/workshops`,
};
---

<BaseLayout
  title="AI Workshops — Learn Generative AI | Prompster"
  description="Join our exclusive AI workshops. Master Midjourney, ChatGPT, and other generative AI tools through interactive, practical sessions."
  canonicalUrl={`${siteUrl}/workshops`}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
    slot="head"
  />
  <Header slot="header" />

  <main id="workshops-main" style="padding-top: var(--header-height);">
    <section class="page-hero container" style="padding-top: 4rem; padding-bottom: 4rem; text-align: center;">
      <h1 class="page-hero__title" style="font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 800; margin-bottom: 1rem; background: linear-gradient(135deg, #fff 0%, #a3a3a3 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">AI Workshops</h1>
      <p class="page-hero__subtitle" style="font-size: var(--text-lg); color: var(--color-text-secondary); max-width: 600px; margin: 0 auto; line-height: 1.6;">
        Master the art of generative AI. Join our expert-led teaching content workshops and learn practical AI skills you can use today.
      </p>
    </section>

    <section class="container" style="padding-bottom: 6rem;">
      <h2 style="font-size: var(--text-2xl); font-weight: 700; margin-bottom: 2rem; display: flex; align-items: center; gap: 0.5rem;">
        <span style="display: inline-block; width: 12px; height: 12px; border-radius: 50%; background: var(--color-accent-emerald); box-shadow: 0 0 12px var(--color-accent-emerald);"></span>
        Upcoming Workshops
      </h2>
      
      {upcomingWorkshops.length > 0 ? (
        <div class="workshops-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 2rem;">
          {upcomingWorkshops.map((workshop) => (
            <a href={`/workshops/${workshop.slug}`} class="workshop-card glass-card" style="display: flex; flex-direction: column; border-radius: var(--radius-2xl); overflow: hidden; text-decoration: none; color: inherit; transition: transform 0.2s, box-shadow 0.2s;">
              <div style="background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(139, 92, 246, 0.2)); height: 140px; position: relative; border-bottom: 1px solid var(--color-border-subtle);">
                <div style="position: absolute; top: 1rem; right: 1rem; background: var(--color-bg-primary); padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 700; border: 1px solid var(--color-border-subtle);">
                  {workshop.format.toUpperCase()}
                </div>
              </div>
              <div style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column;">
                <h3 style="font-size: var(--text-xl); font-weight: 700; margin-bottom: 0.5rem;">{workshop.title}</h3>
                <p style="color: var(--color-text-secondary); font-size: var(--text-sm); margin-bottom: 1rem; line-height: 1.6;">{workshop.topic}</p>
                
                <div style="margin-top: auto; display: flex; flex-direction: column; gap: 0.5rem; background: var(--color-bg-secondary); padding: 1rem; border-radius: var(--radius-lg); border: 1px solid var(--color-border-subtle);">
                  <div style="display: flex; justify-content: space-between; font-size: var(--text-sm);">
                    <span style="color: var(--color-text-muted);">Date</span>
                    <strong style="color: var(--color-text-primary);">{new Date(workshop.scheduled_date).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}</strong>
                  </div>
                  <div style="display: flex; justify-content: space-between; font-size: var(--text-sm);">
                    <span style="color: var(--color-text-muted);">Duration</span>
                    <strong style="color: var(--color-text-primary);">{workshop.duration_minutes} mins</strong>
                  </div>
                  <div style="display: flex; justify-content: space-between; font-size: var(--text-sm); margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed var(--color-border-subtle);">
                    <span style="color: var(--color-text-muted);">Fee</span>
                    <strong style="color: var(--color-accent-primary); font-size: var(--text-base);">₹{workshop.fee_amount}</strong>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div style="text-align: center; padding: 4rem; background: var(--color-bg-elevated); border: 1px dashed var(--color-border-subtle); border-radius: var(--radius-2xl);">
          <h3 style="font-size: var(--text-lg); margin-bottom: 0.5rem;">No upcoming workshops</h3>
          <p style="color: var(--color-text-secondary);">We are planning some great content. Check back soon!</p>
        </div>
      )}
      
      {pastWorkshops.length > 0 && (
        <div style="margin-top: 4rem;">
          <h2 style="font-size: var(--text-xl); font-weight: 700; margin-bottom: 1.5rem; color: var(--color-text-secondary);">Past Workshops</h2>
          <div class="workshops-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem; opacity: 0.7;">
            {pastWorkshops.map((workshop) => (
              <div class="workshop-card glass-card" style="display: flex; flex-direction: column; border-radius: var(--radius-2xl); overflow: hidden; pointer-events: none;">
                <div style="padding: 1.5rem;">
                  <h3 style="font-size: var(--text-lg); font-weight: 600; margin-bottom: 0.5rem;">{workshop.title}</h3>
                  <div style="display: flex; justify-content: space-between; font-size: var(--text-sm); color: var(--color-text-muted);">
                    <span>{new Date(workshop.scheduled_date).toLocaleDateString()}</span>
                    <span>Completed</span>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}
    </section>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .workshop-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.4);
    border-color: var(--color-accent-primary);
  }
</style>
