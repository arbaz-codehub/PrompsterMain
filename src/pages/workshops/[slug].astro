---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { createSupabaseClient } from "../../lib/supabase";

const { slug } = Astro.params;
const supabase = createSupabaseClient(Astro.cookies, Astro.request);

const { data: workshop } = await supabase
  .from("workshops")
  .select("*")
  .eq("slug", slug)
  .single();

if (!workshop) {
  return Astro.redirect('/404');
}

const user = Astro.locals.user;
let isRegistered = false;

if (user) {
  const { data: reg } = await supabase
    .from("workshop_registrations")
    .select("status")
    .eq("user_id", user.id)
    .eq("workshop_id", workshop.id)
    .maybeSingle();
    
  if (reg && reg.status === "CONFIRMED") {
    isRegistered = true;
  }
}

const siteUrl = import.meta.env.SITE_URL || "https://www.prompster.shop";
---

<BaseLayout
  title={`${workshop.title} — AI Workshop | Prompster`}
  description={`Join this workshop on ${workshop.topic}. Learn practical AI skills.`}
>
  <Header slot="header" />

  <main style="padding-top: var(--header-height); padding-bottom: 6rem;">
    <!-- Hero / Header -->
    <div style="background: linear-gradient(to bottom, var(--color-bg-secondary), var(--color-bg-primary)); border-bottom: 1px solid var(--color-border-subtle); padding: 4rem 0;">
      <div class="container" style="max-width: 900px;">
        <a href="/workshops" style="color: var(--color-text-muted); text-decoration: none; font-size: var(--text-sm); margin-bottom: 2rem; display: inline-block;">&larr; All Workshops</a>
        
        <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem; flex-wrap: wrap;">
          <span style="background: var(--color-accent-primary); color: #000; padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 700;">
            {workshop.format.toUpperCase()}
          </span>
          <span style="background: var(--color-bg-elevated); border: 1px solid var(--color-border-subtle); padding: 0.25rem 0.75rem; border-radius: var(--radius-full); font-size: 0.75rem; font-weight: 600;">
            {workshop.duration_minutes} MINS
          </span>
        </div>
        
        <h1 style="font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 800; margin-bottom: 1rem; line-height: 1.2;">
          {workshop.title}
        </h1>
        <p style="font-size: var(--text-xl); color: var(--color-text-secondary); line-height: 1.6;">
          {workshop.topic}
        </p>
      </div>
    </div>

    <!-- Content & Sidebar -->
    <div class="container" style="max-width: 900px; padding-top: 4rem;">
      <div style="display: grid; grid-template-columns: 1fr 320px; gap: 4rem; align-items: start;" class="workshop-grid">
        
        <div class="workshop-content">
          <h2 style="font-size: var(--text-2xl); font-weight: 700; margin-bottom: 1.5rem;">About this Workshop</h2>
          <div style="color: var(--color-text-secondary); line-height: 1.8; font-size: var(--text-base); margin-bottom: 3rem;">
            <!-- Placeholder for rich text or markdown content -->
            <p style="margin-bottom: 1rem;">This AI teaching content workshop is designed to help you practical skills in generative AI. You will learn the core concepts and get hands-on experience.</p>
            <p>We'll cover practical use-cases, prompt engineering strategies, and how to integrate these tools into your daily workflows.</p>
          </div>

          <h2 style="font-size: var(--text-2xl); font-weight: 700; margin-bottom: 1.5rem;">Who is this for?</h2>
          <div style="background: var(--color-bg-secondary); padding: 1.5rem; border-radius: var(--radius-xl); border: 1px solid var(--color-border-subtle);">
            <p style="color: var(--color-text-primary); line-height: 1.6;">{workshop.eligibility}</p>
          </div>
        </div>

        <aside class="workshop-sidebar glass-card" style="border-radius: var(--radius-2xl); padding: 2rem; position: sticky; top: calc(var(--header-height) + 2rem);">
          <div style="margin-bottom: 2rem;">
            <p style="color: var(--color-text-muted); font-size: var(--text-sm); margin-bottom: 0.5rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Registration Fee</p>
            <div style="font-size: 3rem; font-weight: 800; line-height: 1; color: var(--color-accent-emerald);">
              ₹{workshop.fee_amount}
            </div>
          </div>
          
          <div style="display: flex; flex-direction: column; gap: 1rem; margin-bottom: 2rem;">
            <div style="display: flex; gap: 1rem; align-items: flex-start;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-text-muted); flex-shrink: 0;"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
              <div>
                <strong style="display: block; font-size: var(--text-sm); margin-bottom: 0.25rem;">Date & Time</strong>
                <span style="color: var(--color-text-secondary); font-size: var(--text-sm);">{new Date(workshop.scheduled_date).toLocaleString()}</span>
              </div>
            </div>
            
            <div style="display: flex; gap: 1rem; align-items: flex-start;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--color-text-muted); flex-shrink: 0;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <div>
                <strong style="display: block; font-size: var(--text-sm); margin-bottom: 0.25rem;">Location</strong>
                <span style="color: var(--color-text-secondary); font-size: var(--text-sm); text-transform: capitalize;">{workshop.format}</span>
              </div>
            </div>
          </div>

          <div id="payment-status-message" style="display: none; padding: 1rem; border-radius: var(--radius-md); margin-bottom: 1rem; font-size: var(--text-sm); text-align: center; font-weight: 600;"></div>

          {isRegistered ? (
             <button class="btn" style="width: 100%; background: var(--color-accent-emerald); color: #000; cursor: default;" disabled>
               ✓ Registered
             </button>
             <p style="text-align: center; margin-top: 1rem; font-size: var(--text-xs); color: var(--color-text-muted);">
               Check your email for the invite link.
             </p>
          ) : !user ? (
             <a href={`/login?redirect=/workshops/${workshop.slug}`} class="btn btn--primary" style="width: 100%; justify-content: center; padding: 1rem;">
               Log in to Register
             </a>
          ) : (
             <button id="pay-btn" data-workshop-id={workshop.id} class="btn btn--primary" style="width: 100%; justify-content: center; padding: 1rem; font-size: var(--text-lg);">
               Register & Pay
             </button>
          )}

          <div id="cashfree-dropin-container" style="margin-top: 1rem; width: 100%;"></div>
        </aside>
      </div>
    </div>
  </main>

  <Footer slot="footer" />
</BaseLayout>

<style>
  @media (max-width: 900px) {
    .workshop-grid {
      grid-template-columns: 1fr !important;
    }
    .workshop-sidebar {
      position: static !important;
    }
  }
</style>

<script>
  import { load } from '@cashfreepayments/cashfree-js';

  document.addEventListener('astro:page-load', () => {
    const payBtn = document.getElementById('pay-btn') as HTMLButtonElement;
    const statusMsg = document.getElementById('payment-status-message') as HTMLDivElement;
    
    // Check URL params for redirect from Cashfree verify endpoint
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('payment') === 'success') {
      if (statusMsg) {
        statusMsg.style.display = 'block';
        statusMsg.style.background = 'rgba(16, 185, 129, 0.1)';
        statusMsg.style.color = 'var(--color-accent-emerald)';
        statusMsg.textContent = 'Payment successful! Registration confirmed.';
      }
      if (payBtn) payBtn.style.display = 'none';
      return;
    }

    if (payBtn) {
      payBtn.addEventListener('click', async () => {
        const workshopId = payBtn.getAttribute('data-workshop-id');
        const originalText = payBtn.textContent;
        payBtn.disabled = true;
        payBtn.textContent = 'Processing...';

        try {
          const res = await fetch('/api/payments/create-order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ itemId: workshopId, itemType: 'WORKSHOP' })
          });

          const data = await res.json();

          if (!res.ok) {
            throw new Error(data.error || 'Payment initiation failed');
          }

          // Initialize Cashfree
          const env = import.meta.env.PUBLIC_CASHFREE_ENV === 'PRODUCTION' ? 'production' : 'sandbox';
          const cashfree = await load({ mode: env });

          // Start Checkout
          cashfree.checkout({
            paymentSessionId: data.payment_session_id
          });
          
        } catch (error: any) {
          console.error(error);
          statusMsg.style.display = 'block';
          statusMsg.style.background = 'rgba(239, 68, 68, 0.1)';
          statusMsg.style.color = 'var(--color-danger)';
          statusMsg.textContent = error.message;
          payBtn.disabled = false;
          payBtn.textContent = originalText;
        }
      });
    }
  });
</script>
