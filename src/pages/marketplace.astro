---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import { createSupabaseClient } from "../lib/supabase";
import ImagePreviewExperiment from "../components/ImagePreviewExperiment.astro";
import SmartFilter from "../components/SmartFilter.astro";

const siteUrl = import.meta.env.SITE_URL || "https://www.prompster.shop";

// Fetch dynamic data from Supabase
const supabase = createSupabaseClient(Astro.cookies, Astro.request);
const { data: marketplaceItems } = await supabase
  .from("marketplace_items")
  .select("*")
  .order("created_at", { ascending: false });

const mockItems = [
  {
    id: "1",
    title: "Master AI Portrait Prompts",
    description:
      "A comprehensive collection of 500+ portrait prompts for Midjourney v6.",
    image_url:
      "https://images.unsplash.com/photo-1542038784456-1ea8e935640e?auto=format&fit=crop&q=80&w=800",
    tag: "Prompt Pack",
    status: "live",
    link: "#",
  },
  {
    id: "2",
    title: "Notion Creator OS",
    description:
      "Manage your entire prompt engineering workflow directly inside Notion.",
    image_url:
      "https://images.unsplash.com/photo-1611162617474-5b21e879e113?auto=format&fit=crop&q=80&w=800",
    tag: "Workflow",
    status: "live",
    link: "#",
  },
  {
    id: "3",
    title: "The AI Copywriter",
    description: "Master prompt framework for generating high-converting copy.",
    image_url:
      "https://images.unsplash.com/photo-1455390582262-044cdead27d8?auto=format&fit=crop&q=80&w=800",
    tag: "Master Prompt",
    status: "coming_soon",
    link: "#",
  },
];

const items =
  marketplaceItems && marketplaceItems.length > 0
    ? marketplaceItems
    : mockItems;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: "Prompster Marketplace",
  description:
    "The premier digital marketplace for AI prompt packs, GPT master prompts, productivity workflows, and proprietary AI tools.",
  url: `${siteUrl}/marketplace`,
};
---

<BaseLayout
  title="Marketplace — AI Prompt Packs & Tools | Prompster"
  description="Shop premium AI prompt packs, GPT master prompts, productivity workflows, content creation kits, and proprietary tools."
  canonicalUrl={`${siteUrl}/marketplace`}
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(jsonLd)}
    slot="head"
  />
  <Header slot="header" />

  <main id="marketplace-main">
    <section class="page-hero container">
      <h1 class="page-hero__title">The AI Prompt Marketplace</h1>
      <p class="page-hero__subtitle">
        Curated prompt packs, master frameworks, and tools handcrafted to get
        the very best from AI.
      </p>
    </section>

    <section class="container mkt-section" aria-label="Marketplace categories">
      <SmartFilter
        targetGrid=".mkt-grid"
        itemClass=".mkt-card"
        titleClass=".mkt-card__title"
        descClass=".mkt-card__desc"
        tagClass=".mkt-card__tag"
      />
      <div class="mkt-grid" role="list">
        {
          items.length > 0 ? (
            items.map((item) => (
              <article class="mkt-card" role="listitem">
                <div class="mkt-card__cover">
                  {item.image_url ? (
                    <Image
                      src={item.image_url}
                      alt={item.title}
                      width={400}
                      height={225}
                      class="mkt-card__img preview-trigger"
                      data-preview={item.image_url}
                    />
                  ) : (
                    <div class="mkt-card__placeholder">No Image</div>
                  )}
                </div>

                <div class="mkt-card__content">
                  <div class="mkt-card__meta">
                    <span class="mkt-card__tag">{item.tag}</span>
                  </div>
                  <h3 class="mkt-card__title">{item.title}</h3>
                  <p class="mkt-card__desc">{item.description}</p>
                  <footer class="mkt-card__footer">
                    {item.status === "live" ? (
                      <a
                        href={item.link || "#"}
                        class="btn btn--primary mkt-card__btn"
                      >
                        View Pack →
                      </a>
                    ) : (
                      <button class="mkt-card__btn-disabled" disabled>
                        Coming Soon
                      </button>
                    )}
                  </footer>
                </div>
              </article>
            ))
          ) : (
            <div class="mkt-empty">
              <p>
                The marketplace is currently being stocked. Check back soon!
              </p>
            </div>
          )
        }
      </div>
    </section>

    <section class="mkt-notify container">
      <div class="glass-card mkt-notify__card">
        <div class="mkt-notify__icon">🔔</div>
        <h2 class="mkt-notify__title">Get Notified at Launch</h2>
        <p class="mkt-notify__desc">
          Be the first to access exclusive prompt packs and early-bird discounts
          when the marketplace goes live.
        </p>
        <form class="mkt-notify__form" id="notify-form">
          <input
            type="email"
            class="mkt-notify__input"
            placeholder="your@email.com"
            required
            aria-label="Email address"
            id="notify-email"
          />
          <button type="submit" class="btn btn--primary" id="notify-btn"
            >Notify Me</button
          >
        </form>
        <p class="mkt-notify__privacy">No spam. Unsubscribe any time.</p>
      </div>
    </section>
  </main>

  <ImagePreviewExperiment />

  <Footer slot="footer" />
</BaseLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    const form = document.getElementById("notify-form") as HTMLFormElement;
    if (form) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = document.getElementById("notify-btn") as HTMLButtonElement;
        const emailInput = document.getElementById(
          "notify-email",
        ) as HTMLInputElement;

        if (btn && emailInput) {
          const originalText = btn.textContent;
          btn.textContent = "Joining...";
          btn.disabled = true;

          try {
            const res = await fetch("/api/waitlist", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ email: emailInput.value }),
            });

            if (res.ok) {
              btn.textContent = "✓ You're on the list!";
              btn.style.background = "var(--color-accent-emerald)";
            } else {
              throw new Error("Failed to join");
            }
          } catch (err) {
            btn.textContent = "Error. Try again?";
            btn.disabled = false;
            setTimeout(() => {
              btn.textContent = originalText;
            }, 3000);
          }
        }
      });
    }

    document.querySelectorAll(".mkt-card").forEach((card) => {
      card.addEventListener("mousemove", (e) => {
        const mouseEvent = e as MouseEvent;
        const rect = card.getBoundingClientRect();
        const x = mouseEvent.clientX - rect.left;
        const y = mouseEvent.clientY - rect.top;
        (card as HTMLElement).style.setProperty("--mouse-x", `${x}px`);
        (card as HTMLElement).style.setProperty("--mouse-y", `${y}px`);
      });
    });
  });
</script>

<style>
  .page-hero {
    padding: 120px var(--space-4) var(--space-8);
    text-align: center;
  }
  .page-hero__title {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    background: linear-gradient(135deg, #fff 0%, #a3a3a3 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: var(--space-4);
  }
  .page-hero__subtitle {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .mkt-section {
    padding: 0 0 var(--space-16);
  }

  .mkt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: var(--space-8);
  }

  .mkt-empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 4rem;
    color: var(--color-text-muted);
    background: var(--color-bg-elevated);
    border-radius: var(--radius-2xl);
    border: 1px dashed var(--color-border-subtle);
  }

  .mkt-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-2xl);
    transition:
      transform var(--transition-base),
      box-shadow var(--transition-base);
    background: var(--color-bg-card);
    border: 1px solid var(--color-border-subtle);
    overflow: hidden;
  }
  .mkt-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      350px circle at var(--mouse-x, -1000px) var(--mouse-y, -1000px),
      rgba(255, 255, 255, 0.1),
      transparent 80%
    );
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
    z-index: 1;
  }
  .mkt-card:hover::before {
    opacity: 1;
  }
  .mkt-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-glow);
    border-color: var(--color-border-hover);
  }

  .mkt-card__cover,
  .mkt-card__content {
    position: relative;
    z-index: 2;
    pointer-events: auto;
  }
  .mkt-card__cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-elevated);
    border-bottom: 1px solid var(--color-border-subtle);
  }
  .mkt-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .mkt-card:hover .mkt-card__img {
    transform: scale(1.05);
  }
  .mkt-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .mkt-card__content {
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .mkt-card__meta {
    display: flex;
    align-items: center;
  }
  .mkt-card__tag {
    font-size: 11px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-full);
    background: var(--color-bg-elevated);
    color: var(--color-text-primary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1px solid var(--color-border-subtle);
  }

  .mkt-card__title {
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.3;
  }
  .mkt-card__desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: 1.7;
    flex: 1;
  }

  .mkt-card__footer {
    margin-top: var(--space-4);
    display: flex;
  }
  .mkt-card__btn {
    width: 100%;
    justify-content: center;
    font-weight: 600;
  }
  .mkt-card__btn-disabled {
    width: 100%;
    font-size: var(--text-sm);
    font-weight: 600;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-subtle);
    color: var(--color-text-muted);
    background: var(--color-bg-elevated);
    cursor: not-allowed;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    transition: background var(--transition-fast);
  }
  .mkt-card__btn-disabled:hover {
    background: var(--color-bg-tertiary);
  }

  .mkt-notify {
    padding: 0 0 var(--space-20);
  }
  .mkt-notify__card {
    max-width: 500px;
    margin: 0 auto;
    text-align: center;
    padding: var(--space-10) var(--space-8);
    border-radius: var(--radius-2xl);
    border: 1px solid var(--color-border-subtle);
  }
  .mkt-notify__icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-4);
  }
  .mkt-notify__title {
    font-size: var(--text-xl);
    font-weight: 700;
    margin-bottom: var(--space-3);
  }
  .mkt-notify__desc {
    color: var(--color-text-secondary);
    font-size: var(--text-sm);
    line-height: 1.7;
    margin-bottom: var(--space-6);
  }
  .mkt-notify__form {
    display: flex;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .mkt-notify__input {
    flex: 1;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    padding: 0 var(--space-4);
    color: var(--color-text-primary);
    outline: none;
    transition: border-color var(--transition-fast);
  }
  .mkt-notify__input:focus {
    border-color: var(--color-border-hover);
  }
  .mkt-notify__privacy {
    font-size: 11px;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 640px) {
    .page-hero {
      padding: 100px var(--space-4) var(--space-6);
    }
    .mkt-notify__form {
      flex-direction: column;
    }
  }
</style>
