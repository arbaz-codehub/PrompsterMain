---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { Image } from 'astro:assets';
import { createSupabaseClient } from '../lib/supabase';
import ImagePreviewExperiment from '../components/ImagePreviewExperiment.astro';
import SmartFilter from '../components/SmartFilter.astro';

const siteUrl = import.meta.env.SITE_URL || 'https://prompster.art';

// Fetch dynamic data from Supabase
const supabase = createSupabaseClient(Astro.cookies, Astro.request);
const { data: dbLibraries } = await supabase.from('resources_items').select('*').order('created_at', { ascending: true });

const mockLibraries = [
  { 
    id: 'ai-tools',
    icon: '🤖', 
    title: 'AI Tools Knowledge Library', 
    description: 'The most powerful AI platforms available right now, categorized for chatbots, image generation, video, and audio.', 
    color: 'var(--color-accent-cyan)',
    count: '24+ Tools',
    image_url: 'https://images.unsplash.com/photo-1677442136019-21780ecad995?auto=format&fit=crop&q=80&w=800'
  },
  { 
    id: 'free-websites',
    icon: '🌐', 
    title: 'Free Websites Library', 
    description: 'Essential free tools and design resources for every creator. Stock photos, icons, and productivity apps.', 
    color: 'var(--color-accent-emerald)',
    count: '50+ Sites',
    image_url: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&q=80&w=800'
  },
  { 
    id: 'free-music',
    icon: '🎵', 
    title: 'Free Music Library', 
    description: 'Royalty-free music for YouTube, podcasts, social media, and commercial projects.', 
    color: 'var(--color-accent-amber)',
    count: '12+ Platforms',
    image_url: 'https://images.unsplash.com/photo-1511379938547-c1f69419868d?auto=format&fit=crop&q=80&w=800'
  },
];

const libraries = dbLibraries && dbLibraries.length > 0 ? dbLibraries : mockLibraries;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Resources — AI Tools, Free Websites & Music Library | Prompster",
  "description": "A curated knowledge library for creators. Discover the best AI tools, free design websites, royalty-free music, and more.",
  "url": `${siteUrl}/resources`,
};
---

<BaseLayout
  title="Resources — AI Tools, Free Websites & Music Library | Prompster"
  description="Curated knowledge library for AI creators. Discover the best AI tools, free design websites, royalty-free music libraries, and creator resources — all in one place."
  canonicalUrl={`${siteUrl}/resources`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />
  <Header slot="header" />

  <main id="resources-main">
    <section class="page-hero container">
      <h1 class="page-hero__title">The Creator's Resource Hub</h1>
      <p class="page-hero__subtitle">Everything a modern creator needs — AI tools, free assets, music, and more. Curated, categorised, and constantly updated.</p>
    </section>

    <div class="container res-content">
      <SmartFilter 
        targetGrid=".res-grid" 
        itemClass=".res-card" 
        titleClass=".res-card__title" 
        descClass=".res-card__desc" 
        tagClass=".res-card__tag" 
      />
      <div class="res-grid" role="list">
        {libraries.map((lib) => (
          <article class="res-card" role="listitem">
            <div class="res-card__cover">
              {lib.image_url ? (
                <Image 
                  src={lib.image_url} 
                  alt={lib.title} 
                  width={400} 
                  height={225} 
                  class="res-card__img preview-trigger"
                  data-preview={lib.image_url}
                />
              ) : (
                <div class="res-card__placeholder">No Image</div>
              )}
            </div>
            
            <div class="res-card__content">
              <div class="res-card__meta">
                <span class="res-card__tag" style={`color: ${lib.color}; border-color: ${lib.color}40; background: ${lib.color}10;`}>
                  {lib.icon} {lib.count}
                </span>
              </div>
              <h3 class="res-card__title">{lib.title}</h3>
              <p class="res-card__desc">{lib.description}</p>
              <footer class="res-card__footer">
                <a href={`/resources/${lib.id}`} class="btn btn--primary res-card__btn" style={`background: ${lib.color}; color: #000;`}>Open Library →</a>
              </footer>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
  
  <ImagePreviewExperiment />

  <Footer slot="footer" />
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('.res-card').forEach((card) => {
      card.addEventListener('mousemove', (e) => {
        const mouseEvent = e as MouseEvent;
        const rect = card.getBoundingClientRect();
        const x = mouseEvent.clientX - rect.left;
        const y = mouseEvent.clientY - rect.top;
        (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
        (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
      });
    });
  });
</script>

<style>
  .page-hero { padding: 120px var(--space-4) var(--space-8); text-align: center; }
  .page-hero__title { font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 800; background: linear-gradient(135deg,#fff 0%,#a3a3a3 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: var(--space-4); }
  .page-hero__subtitle { font-size: var(--text-lg); color: var(--color-text-secondary); max-width: 600px; margin: 0 auto; line-height: 1.6; }

  .res-content { padding: 0 0 var(--space-20); }

  .res-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: var(--space-8); }
  
  .res-card { position: relative; display: flex; flex-direction: column; border-radius: var(--radius-2xl); transition: transform var(--transition-base), box-shadow var(--transition-base); background: var(--color-bg-card); border: 1px solid var(--color-border-subtle); overflow: hidden; }
  .res-card::before { content: ''; position: absolute; inset: 0; background: radial-gradient(350px circle at var(--mouse-x, -1000px) var(--mouse-y, -1000px), rgba(255, 255, 255, 0.1), transparent 80%); opacity: 0; transition: opacity 0.3s ease; pointer-events: none; z-index: 1; }
  .res-card:hover::before { opacity: 1; }
  .res-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-glow); border-color: var(--color-border-hover); }

  .res-card__link { display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; }
  
  .res-card__cover, .res-card__content { position: relative; z-index: 2; pointer-events: auto; }
  .res-card__cover { width: 100%; aspect-ratio: 16 / 9; overflow: hidden; background: var(--color-bg-elevated); border-bottom: 1px solid var(--color-border-subtle); }
  .res-card__img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .res-card:hover .res-card__img { transform: scale(1.05); }
  .res-card__placeholder { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; color: var(--color-text-muted); font-size: var(--text-sm); font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em; }

  .res-card__content { padding: var(--space-6); display: flex; flex-direction: column; gap: var(--space-3); flex: 1; }
  
  .res-card__meta { display: flex; align-items: center; }
  .res-card__tag { font-size: 11px; font-weight: 600; padding: 4px 12px; border-radius: var(--radius-full); background: var(--color-bg-elevated); text-transform: uppercase; letter-spacing: .08em; border: 1px solid var(--color-border-subtle); display: flex; align-items: center; gap: 6px; }
  
  .res-card__title { font-size: var(--text-xl); font-weight: 700; line-height: 1.3; }
  .res-card__desc { font-size: var(--text-sm); color: var(--color-text-secondary); line-height: 1.7; flex: 1; }
  
  .res-card__footer { margin-top: var(--space-4); display: flex; }
  .res-card__btn { width: 100%; justify-content: center; font-weight: 700; border: none; }

  @media (max-width: 640px) {
    .page-hero { padding: 100px var(--space-4) var(--space-6); }
  }
</style>
