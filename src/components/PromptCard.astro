---
import type { Prompt } from '../lib/types';
import TagBadge from './TagBadge.astro';

interface Props {
  prompt: Prompt;
  eager?: boolean;
}

const { prompt, eager = false } = Astro.props;
const primaryImage = prompt.images[0] || 'https://picsum.photos/seed/default/800/600';

function getOptimizedUrl(url: string) {
  if (url.includes('unsplash.com')) {
    return url.includes('?') ? `${url}&fm=webp&q=80&w=600` : `${url}?fm=webp&q=80&w=600`;
  }
  return url;
}
const optimizedImage = getOptimizedUrl(primaryImage);
---

<a href={`/prompt/${prompt.slug}`} class="prompt-card animate-fade-in-up" id={`card-${prompt.id}`} data-astro-prefetch="hover" title={`${prompt.title} - ${prompt.category}`}>
  <div class="prompt-card__image-wrap skeleton">
    <img
      src={optimizedImage}
      alt={prompt.title}
      class="prompt-card__image"
      decoding="async"
      loading={eager ? "eager" : "lazy"}
      transition:name={`img-${prompt.id}`}
      style="opacity: 0; transition: opacity 0.15s ease-out;"
      onload="this.style.opacity = 1; this.parentElement.classList.remove('skeleton');"
    />
    <div class="prompt-card__top-actions">
      <button class="favorite-btn" data-prompt-id={prompt.id} aria-label="Save to Favourites">
        <svg class="heart-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
        </svg>
      </button>
    </div>
    
    <div class="prompt-card__overlay">
      <span class="prompt-card__category">{prompt.category}</span>
      <h3 class="prompt-card__title">{prompt.title}</h3>
      <div class="prompt-card__tags">
        {prompt.tags.slice(0, 3).map((tag) => (
          <span class="tag-badge">#{tag}</span>
        ))}
      </div>
    </div>
  </div>
</a>
