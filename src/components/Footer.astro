---
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__inner">
      <p class="site-footer__copy">
        &copy; {currentYear} Prompster. Crafted for AI creators.
      </p>
      <div class="site-footer__links" style="display: flex; gap: 1.5rem; flex-wrap: wrap; justify-content: center;">
        <a href="/contact" class="site-footer__link">Contact Us</a>
        <a href="/terms" class="site-footer__link">Terms & Conditions</a>
        <a href="/privacy" class="site-footer__link">Privacy Policy</a>
        <a href="/refund" class="site-footer__link">Refund Policy</a>
      </div>
    </div>
  </div>
</footer>
