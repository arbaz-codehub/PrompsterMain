---
interface Props {
  targetGrid: string;
  itemClass: string;
  titleClass: string;
  descClass?: string;
  tagClass: string;
}

const { targetGrid, itemClass, titleClass, descClass, tagClass } = Astro.props;
---

<div class="smart-filter" data-target={targetGrid} data-item={itemClass} data-title={titleClass} data-desc={descClass} data-tag={tagClass}>
  <div class="smart-filter__controls">
    <div class="smart-filter__search-bar">
      <span class="smart-filter__search-icon">🔍</span>
      <input type="text" class="smart-filter__search-input" placeholder="Search for tools, prompts, or resources..." aria-label="Search" />
    </div>

    <div class="smart-filter__category-select-wrapper">
      <select class="smart-filter__category-select" aria-label="Filter by category">
        <option value="all">All Categories</option>
      </select>
      <div class="smart-filter__select-icon">▼</div>
    </div>
  </div>

  <div class="smart-filter__empty-state" style="display: none;">
    <div class="empty-state__icon">🔍</div>
    <h3 class="empty-state__title">No results found</h3>
    <p>Try adjusting your search terms or filters.</p>
  </div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const filters = document.querySelectorAll('.smart-filter');

    filters.forEach(filterEl => {
      const targetGrid = filterEl.getAttribute('data-target');
      const itemClass = filterEl.getAttribute('data-item');
      const titleClass = filterEl.getAttribute('data-title');
      const descClass = filterEl.getAttribute('data-desc');
      const tagClass = filterEl.getAttribute('data-tag');

      if (!targetGrid || !itemClass || !titleClass || !tagClass) return;

      const grid = document.querySelector(targetGrid);
      if (!grid) return;

      const searchInput = filterEl.querySelector('.smart-filter__search-input') as HTMLInputElement;
      const categorySelect = filterEl.querySelector('.smart-filter__category-select') as HTMLSelectElement;
      const emptyState = filterEl.querySelector('.smart-filter__empty-state') as HTMLElement;
      
      const items = Array.from(grid.querySelectorAll(itemClass)) as HTMLElement[];
      
      // Extract unique tags
      const uniqueTags = new Set<string>();
      items.forEach(item => {
        const tagEl = item.querySelector(tagClass);
        if (tagEl && tagEl.textContent) {
          uniqueTags.add(tagEl.textContent.trim());
        }
      });

      // Render dynamic options
      if (categorySelect && uniqueTags.size > 0) {
        categorySelect.innerHTML = '<option value="all">All Categories</option>';
        Array.from(uniqueTags).sort().forEach(tag => {
          const opt = document.createElement('option');
          opt.value = tag.toLowerCase();
          opt.textContent = tag;
          categorySelect.appendChild(opt);
        });
      } else if (categorySelect) {
        // If no tags found (or only empty ones), hide the select wrapper
        (categorySelect.parentElement as HTMLElement).style.display = 'none';
      }

      let currentSearch = '';
      let currentTag = 'all';

      const applyFilters = () => {
        let visibleCount = 0;
        const searchLower = currentSearch.toLowerCase();

        items.forEach(item => {
          const titleEl = item.querySelector(titleClass);
          const descEl = descClass && descClass !== 'undefined' ? item.querySelector(descClass) : null;
          const tagEl = item.querySelector(tagClass);

          const titleText = titleEl?.textContent?.toLowerCase() || '';
          const descText = descEl?.textContent?.toLowerCase() || '';
          const itemTag = tagEl?.textContent?.trim().toLowerCase() || '';

          const matchesSearch = titleText.includes(searchLower) || descText.includes(searchLower);
          const matchesTag = currentTag === 'all' || itemTag === currentTag;

          if (matchesSearch && matchesTag) {
            item.style.display = ''; // Revert to grid/flex default
            visibleCount++;
          } else {
            item.style.display = 'none';
          }
        });

        if (visibleCount === 0) {
          emptyState.style.display = 'flex';
          grid.classList.add('smart-filter-grid-empty');
        } else {
          emptyState.style.display = 'none';
          grid.classList.remove('smart-filter-grid-empty');
        }
      };

      // Event Listeners
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          currentSearch = (e.target as HTMLInputElement).value;
          applyFilters();
        });
      }

      if (categorySelect) {
        categorySelect.addEventListener('change', (e) => {
          currentTag = (e.target as HTMLSelectElement).value;
          applyFilters();
        });
      }
    });
  });
</script>

<style is:global>
  .smart-filter {
    margin-bottom: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    position: relative;
    z-index: 10;
  }

  .smart-filter__controls {
    display: flex;
    flex-direction: row;
    gap: var(--space-4);
    width: 100%;
    max-width: 800px;
    margin: 0 auto;
  }

  .smart-filter__search-bar {
    position: relative;
    flex: 1;
    width: 100%;
  }

  .smart-filter__search-icon {
    position: absolute;
    left: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    font-size: 1.1rem;
    pointer-events: none;
    z-index: 2;
  }

  .smart-filter__search-input {
    width: 100%;
    padding: var(--space-4) var(--space-4) var(--space-4) calc(var(--space-4) * 2.5);
    background: var(--color-bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-primary);
    font-size: var(--text-base);
    outline: none;
    transition: all var(--transition-fast);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
  }

  .smart-filter__search-input:focus {
    border-color: var(--color-border-hover);
    box-shadow: 0 4px 30px rgba(96, 165, 250, 0.15);
    background: rgba(255, 255, 255, 0.05);
  }

  .smart-filter__category-select-wrapper {
    position: relative;
    width: auto;
    flex-shrink: 0;
  }

  .smart-filter__category-select {
    width: 100%;
    height: 100%;
    padding: var(--space-4) calc(var(--space-4) * 2.5) var(--space-4) var(--space-4);
    background: var(--color-bg-glass);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-primary);
    font-size: var(--text-base);
    appearance: none;
    outline: none;
    cursor: pointer;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
    transition: all var(--transition-fast);
  }

  .smart-filter__category-select:focus {
    border-color: var(--color-border-hover);
    box-shadow: 0 4px 30px rgba(96, 165, 250, 0.15);
    background: rgba(255, 255, 255, 0.05);
  }
  
  .smart-filter__category-select option {
    background: var(--color-bg-elevated);
    color: var(--color-text-primary);
  }

  .smart-filter__select-icon {
    position: absolute;
    right: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-muted);
    font-size: 0.8rem;
    pointer-events: none;
  }

  .smart-filter__empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: var(--space-12) var(--space-4);
    text-align: center;
    background: var(--color-bg-elevated);
    border: 1px dashed var(--color-border-subtle);
    border-radius: var(--radius-2xl);
    margin-top: var(--space-4);
    animation: fadeIn 0.3s ease;
  }
  
  .empty-state__icon {
    font-size: 2.5rem;
    margin-bottom: var(--space-3);
  }
  
  .empty-state__title {
    font-size: var(--text-lg);
    font-weight: 700;
    margin-bottom: var(--space-2);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 640px) {
    .smart-filter__controls {
      flex-direction: column;
      align-items: stretch;
    }
    .smart-filter__search-bar {
      width: 100%;
    }
    .smart-filter__category-select-wrapper {
      width: 100%;
    }
  }
</style>
